function isLocale(value: string | null | undefined): value is Locale {
  return (
    value === "de" ||
    value === "fr" ||
    value === "it" ||
    value === "en" ||
    value === "sq" ||
    value === "tr" ||
    value === "pt" ||
    value === "es"
  );
}

function getLocale(): Locale {
  // URL hat IMMER Prioritaet.
  // /fr/anbieter -> fr
  // /it/anbieter -> it
  // /en/anbieter -> en
  const pathLocale = window.location.pathname
    .split("/")
    .filter(Boolean)[0];

  const supported: Locale[] = [
    "de",
    "fr",
    "it",
    "en",
    "sq",
    "tr",
    "pt",
    "es",
  ];

  if (supported.includes(pathLocale as Locale)) {
    return pathLocale as Locale;
  }

  // Nur /anbieter ohne Sprachprefix:
  const cookieMatch = document.cookie.match(
    /(?:^|;\\s*)auftrag_locale=(de|fr|it|en|sq|tr|pt|es)(?:;|$)/,
  );

  if (cookieMatch?.[1]) {
    return cookieMatch[1] as Locale;
  }

  return "de";
}

const originalText = new WeakMap<Text, string>();
const originalAttributes = new WeakMap<Element, Map<string, string>>();

function translateText(value: string, locale: Locale): string {
  if (locale === "de") return value;

  const trimmed = value.trim();
  if (!trimmed) return value;

  const translated = dictionary[trimmed]?.[locale];
  if (!translated) return value;

  const start = value.match(/^\s*/)?.[0] ?? "";
  const end = value.match(/\s*$/)?.[0] ?? "";

  return `${start}${translated}${end}`;
}

function translatePage(locale: Locale) {
  document.documentElement.lang = locale;

  const walker = document.createTreeWalker(
    document.body,
    NodeFilter.SHOW_TEXT,
  );

  let node = walker.nextNode();

  while (node) {
    const textNode = node as Text;

    const parent = textNode.parentElement;
    const tag = parent?.tagName;

    if (
      parent &&
      tag !== "SCRIPT" &&
      tag !== "STYLE" &&
      tag !== "NOSCRIPT" &&
      tag !== "CODE" &&
      tag !== "PRE"
    ) {
      if (!originalText.has(textNode)) {
        originalText.set(textNode, textNode.nodeValue ?? "");
      }

      const original = originalText.get(textNode) ?? "";

      textNode.nodeValue = translateText(original, locale);
    }

    node = walker.nextNode();
  }

  const attributes = ["placeholder", "title", "aria-label"];

  document.querySelectorAll("*").forEach((element) => {
    let originals = originalAttributes.get(element);

    if (!originals) {
      originals = new Map<string, string>();
      originalAttributes.set(element, originals);
    }

    attributes.forEach((attribute) => {
      const current = element.getAttribute(attribute);

      if (current !== null && !originals!.has(attribute)) {
        originals!.set(attribute, current);
      }

      const original = originals!.get(attribute);

      if (original !== undefined) {
        element.setAttribute(
          attribute,
          translateText(original, locale),
        );
      }
    });
  });
}


export function translateProviderText(
  value: string,
  locale: Locale
): string {
  return translateText(value, locale);
}

