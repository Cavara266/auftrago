function isLocale(value: string | null | undefined): value is Locale {
  return (
    value === "de" ||
    value === "fr" ||
    value === "it" ||
    value === "en" ||
    value === "sq" ||
    value === "tr" ||
    value === "pt" ||
    value === "es"
  );
}

function getLocale(): Locale {
  // 1. URL hat IMMER Priorität
  const pathLocale = window.location.pathname
    .split("/")
    .filter(Boolean)[0];

  if (isLocale(pathLocale)) {
    return pathLocale;
  }

  // 2. Query-Parameter, z.B. /anbieter?locale=tr
  const params = new URLSearchParams(window.location.search);
  const queryLocale = params.get("locale");

  if (isLocale(queryLocale)) {
    return queryLocale;
  }

  // 3. Cookie
  const cookieMatch = document.cookie.match(
    /(?:^|;\s*)auftrag_locale=(de|fr|it|en|sq|tr|pt|es)(?:;|$)/
  );

  if (isLocale(cookieMatch?.[1])) {
    return cookieMatch[1];
  }

  // 4. Local Storage
  const stored =
    window.localStorage.getItem("auftrago-language") ||
    window.localStorage.getItem("auftrag_locale");

  if (isLocale(stored)) {
    return stored;
  }

  return "de";
}

const originalText = new WeakMap<Text, string>();
const originalAttributes = new WeakMap<Element, Map<string, string>>();

function translateText(value: string, locale: Locale): string {
  if (locale === "de") return value;

  const trimmed = value.trim();
  if (!trimmed) return value;

  const translated = dictionary[trimmed]?.[locale];
  if (!translated) return value;

  const start = value.match(/^\s*/)?.[0] ?? "";
  const end = value.match(/\s*$/)?.[0] ?? "";

  return `${start}${translated}${end}`;
}

function translatePage(locale: Locale) {
  document.documentElement.lang = locale;

  const walker = document.createTreeWalker(
    document.body,
    NodeFilter.SHOW_TEXT,
  );

  let node = walker.nextNode();

  while (node) {
    const textNode = node as Text;

    const parent = textNode.parentElement;
    const tag = parent?.tagName;

    if (
      parent &&
      tag !== "SCRIPT" &&
      tag !== "STYLE" &&
      tag !== "NOSCRIPT" &&
      tag !== "CODE" &&
      tag !== "PRE"
    ) {
      if (!originalText.has(textNode)) {
        originalText.set(textNode, textNode.nodeValue ?? "");
      }

      const original = originalText.get(textNode) ?? "";

      textNode.nodeValue = translateText(original, locale);
    }

    node = walker.nextNode();
  }

  const attributes = ["placeholder", "title", "aria-label"];

  document.querySelectorAll("*").forEach((element) => {
    let originals = originalAttributes.get(element);

    if (!originals) {
      originals = new Map<string, string>();
      originalAttributes.set(element, originals);
    }

    attributes.forEach((attribute) => {
      const current = element.getAttribute(attribute);

      if (current !== null && !originals!.has(attribute)) {
        originals!.set(attribute, current);
      }

      const original = originals!.get(attribute);

      if (original !== undefined) {
        element.setAttribute(
          attribute,
          translateText(original, locale),
        );
      }
    });
  });
}

export default function ProviderPageAutoTranslate() {
  useEffect(() => {
    let locale = getLocale();
    let observer: MutationObserver | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;
    let raf1 = 0;
    let raf2 = 0;

    const saveLocale = (nextLocale: Locale) => {
      window.localStorage.setItem(
        "auftrago-language",
        nextLocale
      );

      window.localStorage.setItem(
        "auftrag_locale",
        nextLocale
      );

      document.cookie =
        `auftrag_locale=${nextLocale}; Path=/; Max-Age=31536000; SameSite=Lax`;

      document.documentElement.lang = nextLocale;
    };

    const translate = () => {
      locale = getLocale();
      saveLocale(locale);
      translatePage(locale);
    };

    const startObserver = () => {
      if (observer) {
        observer.disconnect();
      }

      observer = new MutationObserver(() => {
        window.requestAnimationFrame(() => {
          translatePage(locale);
        });
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true,
      });
    };

    const start = () => {
      /*
       * WICHTIG:
       * Nicht während React-Hydration am DOM schreiben.
       *
       * Zwei requestAnimationFrame + kleiner Timeout sorgen dafür,
       * dass React zuerst vollständig hydratisieren kann.
       */
      raf1 = window.requestAnimationFrame(() => {
        raf2 = window.requestAnimationFrame(() => {
          timer = window.setTimeout(() => {
            translate();
            startObserver();
          }, 120);
        });
      });
    };

    const handleLocaleChange = (event: Event) => {
      const customEvent = event as CustomEvent<string>;
      const requested = customEvent.detail;

      if (isLocale(requested)) {
        locale = requested;
        saveLocale(locale);

        /*
         * Auch bei Sprachwechsel erst nach dem React-Event-Zyklus
         * ins DOM schreiben.
         */
        window.requestAnimationFrame(() => {
          translatePage(locale);
        });

        return;
      }

      window.requestAnimationFrame(() => {
        translate();
      });
    };

    start();

    window.addEventListener(
      "auftrago-language-change",
      handleLocaleChange
    );

    window.addEventListener(
      "auftrago:locale-change",
      handleLocaleChange
    );

    return () => {
      if (timer) {
        window.clearTimeout(timer);
      }

      window.cancelAnimationFrame(raf1);
      window.cancelAnimationFrame(raf2);

      observer?.disconnect();

      window.removeEventListener(
        "auftrago-language-change",
        handleLocaleChange
      );

      window.removeEventListener(
        "auftrago:locale-change",
        handleLocaleChange
      );
    };
  }, []);

  return null;
}
