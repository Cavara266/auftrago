}

const panel = {
  padding: 24,
  borderRadius: 24,
  border:
    "1px solid rgba(148,163,184,.11)",
  background:
    "rgba(8,19,37,.78)",
} as const;

const eyebrow = {
  color: "#7dd3fc",
  fontSize: 10,
  fontWeight: 950,
  letterSpacing: ".09em",
} as const;

const heading = {
  margin: "7px 0 0",
  fontSize: 20,
  letterSpacing: "-.02em",
} as const;

const smallLink = {
  color: "#7dd3fc",
  textDecoration: "none",
  fontSize: 10,
  fontWeight: 900,
} as const;

const row = {
  display: "flex",
  justifyContent: "space-between",
  gap: 15,
  padding: "13px 8px",
  borderRadius: 10,
  borderBottom:
    "1px solid rgba(148,163,184,.07)",
  color: "inherit",
  textDecoration: "none",
  alignItems: "center",
} as const;

const actionButton = {
  padding: "11px 14px",
  borderRadius: 11,
  border:
    "1px solid rgba(125,211,252,.12)",
  background: "rgba(15,23,42,.52)",
  color: "#cbd5e1",
