function SummaryCard({
  label,
  value,
  description,
  color,
}: {
  label: string;
  value: string;
  description: string;
  color: string;
}) {
  return (
    <div
      className="action-center-card"
      style={{
        padding: 17,
        borderRadius: 17,
        border:
          "1px solid rgba(148,163,184,.10)",
        background:
          "rgba(8,19,37,.62)",
      }}
    >
      <div
        style={{
          color: "#64748b",
          fontSize: 9,
          fontWeight: 950,
          letterSpacing: ".08em",
        }}
      >
        {label}
      </div>

      <div
        style={{
          fontSize: 22,
          fontWeight: 950,
          color,
          marginTop: 6,
          letterSpacing: "-.03em",
        }}
      >
        {value}
      </div>

      <div
        style={{
          color: "#64748b",
          fontSize: 9,
          marginTop: 5,
        }}
      >
        {description}
      </div>
    </div>
  );
}

function EmptyState({
  icon,
  title,
  text,
}: {
  icon: string;
  title: string;
  text: string;
}) {
  return (
    <div
      style={{
        padding: "26px 10px",
        textAlign: "center",
      }}
    >
      <div
        style={{
          width: 40,
          height: 40,
          margin: "0 auto",
          borderRadius: 13,
          display: "grid",
          placeItems: "center",
          background:
            "rgba(34,197,94,.07)",
          border:
            "1px solid rgba(34,197,94,.12)",
          color: "#86efac",
          fontWeight: 950,
        }}
      >
        {icon}
      </div>

      <div
        style={{
          fontWeight: 900,
          marginTop: 11,
          fontSize: 12,
        }}
      >
        {title}
      </div>

      <div
        style={{
          color: "#64748b",
          fontSize: 10,
          marginTop: 4,
          lineHeight: 1.5,
        }}
      >
        {text}
      </div>
    </div>
