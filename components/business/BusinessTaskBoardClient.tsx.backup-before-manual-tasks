"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import { useState } from "react";

type Task = {
  id: string;
  title: string;
  description: string | null;
  href: string | null;
  status: string;
  priority: string;
  valueCents: number;
  dueAt: string | null;
};

const money = (cents: number) =>
  new Intl.NumberFormat("de-CH", {
    style: "currency",
    currency: "CHF",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(cents / 100);

export default function BusinessTaskBoardClient({
  tasks,
}: {
  tasks: Task[];
}) {
  const router = useRouter();
  const [loadingId, setLoadingId] =
    useState<string | null>(null);

  async function updateTask(
    id: string,
    payload: Record<string, unknown>
  ) {
    setLoadingId(id);

    try {
      const response = await fetch(
        `/api/business/tasks/${id}`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.error || "Änderung fehlgeschlagen."
        );
      }

      router.refresh();
    } catch (error) {
      alert(
        error instanceof Error
          ? error.message
          : "Aufgabe konnte nicht aktualisiert werden."
      );
    } finally {
      setLoadingId(null);
    }
  }

  const columns = [
    {
      status: "OPEN",
      label: "OFFEN",
      accent: "#7dd3fc",
    },
    {
      status: "IN_PROGRESS",
      label: "IN ARBEIT",
      accent: "#fbbf24",
    },
    {
      status: "DONE",
      label: "ERLEDIGT",
      accent: "#86efac",
    },
  ];

  return (
    <>
      <style>{`
        .workflow-task-card {
          transition:
            transform .18s ease,
            border-color .18s ease,
            box-shadow .18s ease;
        }

        .workflow-task-card:hover {
          transform: translateY(-3px);
          border-color: rgba(125,211,252,.18) !important;
          box-shadow: 0 18px 50px rgba(2,6,23,.22);
        }

        @media(max-width:1000px) {
          .workflow-board {
            grid-template-columns:1fr !important;
          }
        }
      `}</style>

      <div
        className="workflow-board"
        style={{
          display: "grid",
          gridTemplateColumns:
            "repeat(3,minmax(0,1fr))",
          gap: 13,
          marginTop: 20,
        }}
      >
        {columns.map((column) => {
          const columnTasks = tasks.filter(
            (task) => task.status === column.status
          );

          return (
            <section
              key={column.status}
              style={{
                minWidth: 0,
                padding: 14,
                borderRadius: 18,
                border:
                  "1px solid rgba(148,163,184,.09)",
                background: "rgba(2,6,23,.25)",
              }}
            >
              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  gap: 10,
                  alignItems: "center",
                  padding: "3px 3px 13px",
                }}
              >
                <div
                  style={{
                    color: column.accent,
                    fontSize: 9,
                    fontWeight: 950,
                    letterSpacing: ".09em",
                  }}
                >
                  {column.label}
                </div>

                <div
                  style={{
                    minWidth: 25,
                    height: 25,
                    borderRadius: 8,
                    display: "grid",
                    placeItems: "center",
                    background: "rgba(148,163,184,.06)",
                    color: "#94a3b8",
                    fontSize: 9,
                    fontWeight: 900,
                  }}
                >
                  {columnTasks.length}
                </div>
              </div>

              <div
                style={{
                  display: "grid",
                  gap: 9,
                }}
              >
                {columnTasks.length === 0 && (
                  <div
                    style={{
                      padding: "24px 12px",
                      textAlign: "center",
                      color: "#475569",
                      fontSize: 10,
                    }}
                  >
                    Keine Aufgaben
                  </div>
                )}

                {columnTasks.map((task) => {
                  const priorityColor =
                    task.priority === "CRITICAL"
                      ? "#fca5a5"
                      : task.priority === "HIGH"
                      ? "#fbbf24"
                      : "#7dd3fc";

                  return (
                    <div
                      key={task.id}
                      className="workflow-task-card"
                      style={{
                        padding: 14,
                        borderRadius: 14,
                        border:
                          "1px solid rgba(148,163,184,.08)",
                        background:
                          "linear-gradient(145deg,rgba(8,19,37,.78),rgba(15,23,42,.68))",
                      }}
                    >
                      <div
                        style={{
                          display: "flex",
                          justifyContent: "space-between",
                          gap: 10,
                          alignItems: "start",
                        }}
                      >
                        <span
                          style={{
                            padding: "3px 7px",
                            borderRadius: 6,
                            background:
                              `${priorityColor}10`,
                            color: priorityColor,
                            fontSize: 7,
                            fontWeight: 950,
                            letterSpacing: ".07em",
                          }}
                        >
                          {task.priority}
                        </span>

                        {task.valueCents > 0 && (
                          <strong
                            style={{
                              color: priorityColor,
                              fontSize: 11,
                            }}
                          >
                            {money(task.valueCents)}
                          </strong>
                        )}
                      </div>

                      <div
                        style={{
                          marginTop: 10,
                          fontSize: 12,
                          fontWeight: 900,
                        }}
                      >
                        {task.title}
                      </div>

                      {task.description && (
                        <div
                          style={{
                            marginTop: 5,
                            color: "#64748b",
                            fontSize: 9,
                            lineHeight: 1.5,
                          }}
                        >
                          {task.description}
                        </div>
                      )}

                      <div
                        style={{
                          marginTop: 12,
                        }}
                      >
                        <div
                          style={{
                            color: "#475569",
                            fontSize: 8,
                            fontWeight: 900,
                            marginBottom: 5,
                          }}
                        >
                          FÄLLIG AM
                        </div>

                        <input
                          type="date"
                          defaultValue={
                            task.dueAt
                              ? task.dueAt.slice(0, 10)
                              : ""
                          }
                          disabled={loadingId === task.id}
                          onChange={(e) =>
                            updateTask(task.id, {
                              dueAt:
                                e.target.value || null,
                            })
                          }
                          style={{
                            width: "100%",
                            boxSizing: "border-box",
                            padding: "8px 9px",
                            borderRadius: 8,
                            border:
                              "1px solid rgba(148,163,184,.09)",
                            background: "rgba(2,6,23,.34)",
                            color: "#94a3b8",
                            fontSize: 9,
                            outline: "none",
                          }}
                        />
                      </div>

                      <div
                        style={{
                          display: "grid",
                          gridTemplateColumns:
                            "repeat(2,minmax(0,1fr))",
                          gap: 7,
                          marginTop: 10,
                        }}
                      >
                        {column.status === "OPEN" && (
                          <button
                            type="button"
                            disabled={loadingId === task.id}
                            onClick={() =>
                              updateTask(task.id, {
                                status: "IN_PROGRESS",
                              })
                            }
                            style={buttonStyle}
                          >
                            In Arbeit
                          </button>
                        )}

                        {column.status ===
                          "IN_PROGRESS" && (
                          <>
                            <button
                              type="button"
                              disabled={loadingId === task.id}
                              onClick={() =>
                                updateTask(task.id, {
                                  status: "OPEN",
                                })
                              }
                              style={buttonStyle}
                            >
                              Zurück
                            </button>

                            <button
                              type="button"
                              disabled={loadingId === task.id}
                              onClick={() =>
                                updateTask(task.id, {
                                  status: "DONE",
                                })
                              }
                              style={{
                                ...buttonStyle,
                                color: "#86efac",
                              }}
                            >
                              ✓ Erledigt
                            </button>
                          </>
                        )}

                        {column.status === "DONE" && (
                          <button
                            type="button"
                            disabled={loadingId === task.id}
                            onClick={() =>
                              updateTask(task.id, {
                                status: "OPEN",
                              })
                            }
                            style={buttonStyle}
                          >
                            Wieder öffnen
                          </button>
                        )}

                        {task.href && (
                          <Link
                            href={task.href}
                            style={{
                              ...buttonStyle,
                              display: "grid",
                              placeItems: "center",
                              textDecoration: "none",
                              color: "#7dd3fc",
                            }}
                          >
                            Öffnen →
                          </Link>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    </>
  );
}

const buttonStyle = {
  minHeight: 34,
  padding: "0 9px",
  borderRadius: 8,
  border:
    "1px solid rgba(148,163,184,.09)",
  background: "rgba(15,23,42,.48)",
  color: "#cbd5e1",
  fontSize: 8,
  fontWeight: 900,
  cursor: "pointer",
} as const;
