"use client";

import { useEffect, useRef, useState } from "react";
import styles from "./LanguageSwitcher.module.css";

type Locale = "de" | "fr" | "it" | "en" | "sq" | "tr" | "pt" | "es";

const languages: {
  code: Locale;
  label: string;
  name: string;
  flag: string;
}[] = [
  {
    code: "de",
    label: "DE",
    name: "Deutsch",
    flag: "🇨🇭",
  },
  {
    code: "fr",
    label: "FR",
    name: "Français",
    flag: "🇫🇷",
  },
  {
    code: "it",
    label: "IT",
    name: "Italiano",
    flag: "🇮🇹",
  },
  {
    code: "en",
    label: "EN",
    name: "English",
    flag: "🇬🇧",
  },
  {
    code: "sq",
    label: "SQ",
    name: "Shqip",
    flag: "🇦🇱",
  },
  {
    code: "tr",
    label: "TR",
    name: "Türkçe",
    flag: "🇹🇷",
  },
  {
    code: "pt",
    label: "PT",
    name: "Português",
    flag: "🇵🇹",
  },
  {
    code: "es",
    label: "ES",
    name: "Español",
    flag: "🇪🇸",
  },
];

const STORAGE_KEY = "auftrago-language";
const COOKIE_KEY = "auftrag_locale";

function isLocale(value: string | null): value is Locale {
  return (
    value === "de" ||
    value === "fr" ||
    value === "it" ||
    value === "en" ||
    value === "sq" ||
    value === "tr" ||
    value === "pt" ||
    value === "es"
  );
}

function resolveActiveLocale(): Locale {
  if (typeof window === "undefined") {
    return "de";
  }

  // 1. document.lang:
  // Unsere Übersetzer setzen hier die tatsächlich aktive Sprache.
  const htmlLocale = document.documentElement.lang
    ?.toLowerCase()
    .split("-")[0];

  if (isLocale(htmlLocale)) {
    return htmlLocale;
  }

  // 2. Cookie
  const cookieMatch = document.cookie.match(
    /(?:^|;\s*)(?:auftrag_locale|auftrago_locale)=(de|fr|it|en|sq|tr|pt|es)(?:;|$)/
  );

  if (cookieMatch?.[1] && isLocale(cookieMatch[1])) {
    return cookieMatch[1];
  }

  // 3. sichtbare URL
  const pathLocale = window.location.pathname.match(
    /^\/(de|fr|it|en|sq|tr|pt|es)(?:\/|$)/
  )?.[1];

  if (pathLocale && isLocale(pathLocale)) {
    return pathLocale;
  }

  // 4. bestehende LocalStorage-Keys
  const saved =
    window.localStorage.getItem("auftrago-language") ??
    window.localStorage.getItem("auftrago_locale");

  if (isLocale(saved)) {
    return saved;
  }

  return "de";
}


export default function LanguageSwitcher() {
  const [locale, setLocale] = useState<Locale>("de");
  const [open, setOpen] = useState(false);
  const wrapperRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const syncLocale = () => {
      const nextLocale = resolveActiveLocale();

      setLocale((current) =>
        current === nextLocale ? current : nextLocale
      );
    };

    // Sofort + nach Hydration/DOM-Übersetzung
    syncLocale();

    const timer1 = window.setTimeout(syncLocale, 0);
    const timer2 = window.setTimeout(syncLocale, 100);
    const timer3 = window.setTimeout(syncLocale, 500);

    // Wenn document.documentElement.lang geändert wird
    const langObserver = new MutationObserver(syncLocale);

    langObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["lang"],
    });

    // Bestehende Sprach-Events
    window.addEventListener(
      "auftrago-language-change",
      syncLocale
    );

    window.addEventListener(
      "auftrago:locale-change",
      syncLocale
    );

    window.addEventListener(
      "popstate",
      syncLocale
    );

    window.addEventListener(
      "storage",
      syncLocale
    );

    return () => {
      window.clearTimeout(timer1);
      window.clearTimeout(timer2);
      window.clearTimeout(timer3);

      langObserver.disconnect();

      window.removeEventListener(
        "auftrago-language-change",
        syncLocale
      );

      window.removeEventListener(
        "auftrago:locale-change",
        syncLocale
      );

      window.removeEventListener(
        "popstate",
        syncLocale
      );

      window.removeEventListener(
        "storage",
        syncLocale
      );
    };
  }, []);


  useEffect(() => {
    const match = window.location.pathname.match(
      /^\/(de|fr|it|en|sq|tr|pt|es)(?:\/|$)/
    );

    const urlLocale = isLocale(match?.[1])
      ? match[1]
      : "de";

    setLocale(urlLocale);
    document.documentElement.lang = urlLocale;
  }, []);

  useEffect(() => {
    function handleOutsideClick(event: MouseEvent) {
      if (
        wrapperRef.current &&
        !wrapperRef.current.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    }

    function handleEscape(event: KeyboardEvent) {
      if (event.key === "Escape") {
        setOpen(false);
      }
    }

    document.addEventListener("mousedown", handleOutsideClick);
    document.addEventListener("keydown", handleEscape);

    return () => {
      document.removeEventListener("mousedown", handleOutsideClick);
      document.removeEventListener("keydown", handleEscape);
    };
  }, []);

  function changeLanguage(nextLocale: Locale) {
    const pathname = window.location.pathname;

    // Anbieter-Seite:
    // /anbieter -> /fr/anbieter
    // /fr/anbieter -> /tr/anbieter
    const providerMatch = pathname.match(
      /^\/(?:(de|fr|it|en|sq|tr|pt|es)\/)?anbieter\/?$/
    );

    if (providerMatch) {
      window.localStorage.setItem("auftrago_locale", nextLocale);
      document.cookie =
        `auftrago_locale=${nextLocale}; Path=/; Max-Age=31536000; SameSite=Lax`;

      const providerLocalePath =
        nextLocale === "de"
          ? "/anbieter"
          : `/${nextLocale}/anbieter`;

      window.location.assign(
        providerLocalePath +
          window.location.search +
          window.location.hash
      );

      return;
    }


    setLocale(nextLocale);
    setOpen(false);

    try {
      window.localStorage.removeItem("auftrago_locale");
    } catch {}

    document.cookie =
      "auftrago_locale=; Path=/; Max-Age=0; SameSite=Lax";

    document.documentElement.lang = nextLocale;

    const localeRegex = /^\/(de|fr|it|en|sq|tr|pt|es)(?=\/|$)/;


    const cleanPath = pathname.replace(localeRegex, "") || "/";

    /*
     * Anbieter-Seite:
     *
     * DE  -> /anbieter
     * FR  -> /fr/anbieter
     * IT  -> /it/anbieter
     * EN  -> /en/anbieter
     * SQ  -> /sq/anbieter
     * TR  -> /tr/anbieter
     * PT  -> /pt/anbieter
     * ES  -> /es/anbieter
     */
    const targetPath =
      nextLocale === "de"
        ? cleanPath
        : `/${nextLocale}${cleanPath === "/" ? "" : cleanPath}`;

    window.location.assign(
      targetPath +
      window.location.search +
      window.location.hash
    );
  }

  const active =
    languages.find((language) => language.code === activeLocale) ??
    languages[0];

  return (
    <div
      ref={wrapperRef}
      className={styles.wrapper}
    >
      <button
        type="button"
        className={styles.trigger}
        aria-label="Sprache auswählen"
        aria-haspopup="menu"
        aria-expanded={open}
        onClick={() => setOpen((current) => !current)}
      >
        <span className={styles.globe}>◎</span>

        <span className={styles.activeLanguage}>
          {active.label}
        </span>

        <span
          className={`${styles.chevron} ${
            open ? styles.chevronOpen : ""
          }`}
        >
          ▾
        </span>
      </button>

      {open && (
        <div
          className={styles.menu}
          role="menu"
        >
          <div className={styles.menuHeader}>
            <span>SPRACHE</span>
            <strong>Language</strong>
          </div>

          <div className={styles.languageList}>
            {languages.map((language) => {
              const selected = language.code === activeLocale;

              return (
                <button
                  key={language.code}
                  type="button"
                  role="menuitem"
                  className={`${styles.languageItem} ${
                    selected ? styles.selected : ""
                  }`}
                  onClick={() =>
                    changeLanguage(language.code)
                  }
                >
                  <span className={styles.flag}>
                    {language.flag}
                  </span>

                  <span className={styles.languageName}>
                    <strong>{language.name}</strong>
                    <small>{language.label}</small>
                  </span>

                  <span className={styles.check}>
                    {selected ? "✓" : ""}
                  </span>
                </button>
              );
            })}
          </div>

          <div className={styles.menuFooter}>
            Auftrago · Schweiz
          </div>
        </div>
      )}
    </div>
  );
}
