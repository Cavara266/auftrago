.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(5, 8, 18, 0.82);
  backdrop-filter: blur(24px);
}

.shell {
  width: min(1380px, calc(100% - 40px));
  min-height: 76px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.logo {
  color: #ffffff;
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -1px;
  text-decoration: none;
}

.logo span {
  color: #7c5cff;
}

.desktopNav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.desktopNav a,
.navButton {
  border: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.72);
  font: inherit;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: 180ms ease;
}

.desktopNav a:hover,
.navButton:hover,
.active {
  color: #ffffff !important;
}

.navButton {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.premiumLink {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.premiumLink small {
  padding: 4px 7px;
  border-radius: 999px;
  background: linear-gradient(135deg, #d7b55b, #fff0a8);
  color: #111111;
  font-size: 9px;
  font-weight: 900;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.searchButton,
.primaryButton,
.mobileButton {
  min-height: 42px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
}

.searchButton {
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  padding: 0 17px;
}

.primaryButton {
  display: inline-flex;
  align-items: center;
  padding: 0 19px;
  background: linear-gradient(135deg, #6b5cff, #835eff 48%, #526dff);
  color: #ffffff;
  text-decoration: none;
  box-shadow: 0 12px 34px rgba(101, 88, 255, 0.34);
}

.mobileButton {
  display: none;
  width: 44px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
}

.megaMenu,
.regionMenu {
  position: absolute;
  left: 0;
  right: 0;
  top: 76px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background:
    radial-gradient(circle at 20% 20%, rgba(101, 88, 255, 0.12), transparent 32%),
    #080b15;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
}

.megaMenuInner {
  width: min(1380px, calc(100% - 40px));
  margin: 0 auto;
  padding: 40px 0 46px;
  display: grid;
  grid-template-columns: 310px 1fr;
  gap: 56px;
}

.megaIntro span,
.searchEyebrow {
  color: #8f83ff;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.megaIntro h2 {
  margin: 13px 0;
  color: #ffffff;
  font-size: 28px;
  line-height: 1.08;
  letter-spacing: -1px;
}

.megaIntro p {
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.7;
}

.megaIntro a {
  display: inline-block;
  margin-top: 18px;
  color: #ffffff;
  font-weight: 800;
  text-decoration: none;
}

.megaGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 30px;
}

.megaGroup {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.megaGroup > strong {
  margin-bottom: 8px;
  color: rgba(255, 255, 255, 0.42);
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.megaGroup a {
  display: flex;
  align-items: center;
  gap: 9px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.megaGroup a:hover {
  color: #ffffff;
}

.regionGrid {
  width: min(1000px, calc(100% - 40px));
  margin: 0 auto;
  padding: 30px 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.regionGrid a {
  display: flex;
  justify-content: space-between;
  padding: 17px 18px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.035);
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
}

.mobileMenu {
  display: none;
}

.searchOverlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  overflow-y: auto;
  padding: 100px 20px 40px;
  background: rgba(2, 4, 10, 0.94);
  backdrop-filter: blur(26px);
}

.closeSearch {
  position: fixed;
  top: 28px;
  right: 32px;
  width: 46px;
  height: 46px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
  cursor: pointer;
}

.searchPanel {
  width: min(900px, 100%);
  margin: 0 auto;
}

.searchPanel h2 {
  margin: 12px 0 28px;
  color: #ffffff;
  font-size: clamp(40px, 7vw, 76px);
  letter-spacing: -4px;
}

.searchPanel form {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

.searchPanel input {
  min-height: 66px;
  padding: 0 22px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 17px;
  outline: none;
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
  font-size: 16px;
}

.searchPanel form button {
  padding: 0 28px;
  border: 0;
  border-radius: 17px;
  background: linear-gradient(135deg, #6b5cff, #526dff);
  color: #ffffff;
  font-weight: 900;
  cursor: pointer;
}

.searchResults {
  margin-top: 22px;
  display: grid;
  gap: 9px;
}

.searchResults a {
  display: grid;
  grid-template-columns: 44px 1fr auto;
  align-items: center;
  gap: 13px;
  padding: 16px 18px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.035);
  color: #ffffff;
  text-decoration: none;
}

.searchResults a:hover {
  background: rgba(255, 255, 255, 0.07);
}

.searchResults a > span {
  font-size: 25px;
}

.searchResults strong,
.searchResults small {
  display: block;
}

.searchResults small {
  margin-top: 4px;
  color: rgba(255, 255, 255, 0.47);
}

@media (max-width: 1050px) {
  .desktopNav,
  .searchButton {
    display: none;
  }

  .mobileButton {
    display: block;
  }

  .mobileMenu {
    display: grid;
    gap: 8px;
    padding: 18px 20px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: #080b15;
  }

  .mobileMenu a {
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }

  .megaMenu,
  .regionMenu {
    display: none;
  }
}

@media (max-width: 620px) {
  .shell {
    width: min(100% - 24px, 1380px);
    min-height: 68px;
  }

  .primaryButton {
    display: none;
  }

  .searchOverlay {
    padding-top: 86px;
  }

  .searchPanel h2 {
    letter-spacing: -2px;
  }

  .searchPanel form {
    grid-template-columns: 1fr;
  }

  .searchPanel form button {
    min-height: 56px;
  }
}
/* Navigation wieder vollständig sichtbar */
@media (min-width: 1180px) {
  .desktopNav {
    display: flex !important;
    align-items: center !important;
    gap: 24px !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
  }

  .desktopNav > a,
  .desktopNav > button {
    display: inline-flex !important;
    align-items: center !important;
    white-space: nowrap !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .actions {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    flex: 0 0 auto !important;
  }

  .mobileButton {
    display: none !important;
  }
}

@media (max-width: 1179px) {
  .desktopNav {
    display: none !important;
  }

  .mobileButton {
    display: inline-flex !important;
  }
}


/* =========================================================
   AUFTRAGO MOBILE HEADER – PREMIUM REDESIGN
   ========================================================= */

@media (max-width: 1179px) {
  .header {
    position: sticky;
    top: 0;
    z-index: 3000;
    background:
      linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.98),
        rgba(5, 10, 24, 0.96)
      );
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .shell {
    width: min(100% - 28px, 1380px);
    min-height: 70px;
    gap: 14px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    font-size: 22px;
    line-height: 1;
    white-space: nowrap;
  }

  .desktopNav {
    display: none !important;
  }

  .actions {
    flex: 0 0 auto;
    gap: 8px;
  }

  .primaryButton {
    display: none !important;
  }

  .searchButton,
  .mobileButton {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    background:
      linear-gradient(
        145deg,
        rgba(56, 189, 248, 0.95),
        rgba(99, 102, 241, 0.95)
      );
    box-shadow:
      0 12px 28px rgba(79, 70, 229, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    font-size: 18px;
    font-weight: 900;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .searchButton:active,
  .mobileButton:active {
    transform: scale(0.95);
  }

  .mobileMenu {
    position: fixed;
    z-index: 2999;
    top: 70px;
    right: 0;
    bottom: 0;
    left: 0;

    display: flex;
    flex-direction: column;
    gap: 10px;

    width: 100%;
    max-width: none;
    padding:
      18px
      max(18px, env(safe-area-inset-right))
      max(28px, calc(18px + env(safe-area-inset-bottom)))
      max(18px, env(safe-area-inset-left));

    overflow-y: auto;
    overscroll-behavior: contain;

    background:
      radial-gradient(
        circle at 90% 0%,
        rgba(99, 102, 241, 0.18),
        transparent 34%
      ),
      radial-gradient(
        circle at 0% 20%,
        rgba(56, 189, 248, 0.12),
        transparent 32%
      ),
      linear-gradient(
        180deg,
        rgba(4, 9, 22, 0.995),
        rgba(7, 14, 31, 0.995)
      );

    border-top: 1px solid rgba(255, 255, 255, 0.07);
    animation: auftragoMobileMenuIn 220ms ease-out;
  }

  .mobileMenu::before {
    content: "Navigation";
    display: block;
    margin: 2px 4px 6px;
    color: rgba(148, 163, 184, 0.9);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mobileMenu a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 54px;
    padding: 0 17px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.065),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 10px 28px rgba(0, 0, 0, 0.12);
    color: rgba(255, 255, 255, 0.92);
    font-size: 14px;
    font-weight: 850;
    line-height: 1.25;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .mobileMenu a::after {
    content: "→";
    margin-left: auto;
    padding-left: 14px;
    color: rgba(125, 211, 252, 0.9);
    font-size: 17px;
    font-weight: 900;
  }

  .mobileMenu a:hover,
  .mobileMenu a:focus-visible {
    border-color: rgba(96, 165, 250, 0.38);
    background:
      linear-gradient(
        135deg,
        rgba(56, 189, 248, 0.13),
        rgba(99, 102, 241, 0.13)
      );
    transform: translateY(-1px);
    outline: none;
  }

  .mobileMenu a:last-child {
    margin-top: 8px;
    min-height: 58px;
    justify-content: center;
    border-color: rgba(96, 165, 250, 0.35);
    background:
      linear-gradient(
        135deg,
        #38bdf8,
        #6366f1
      );
    box-shadow:
      0 16px 36px rgba(79, 70, 229, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 15px;
  }

  .mobileMenu a:last-child::after {
    content: "↗";
    margin-left: 10px;
    padding-left: 0;
    color: #ffffff;
  }

  .megaMenu,
  .regionMenu {
    display: none !important;
  }

  .searchOverlay {
    z-index: 4000;
    padding:
      90px
      max(18px, env(safe-area-inset-right))
      30px
      max(18px, env(safe-area-inset-left));
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(99, 102, 241, 0.2),
        transparent 36%
      ),
      rgba(2, 5, 14, 0.985);
  }

  .searchPanel {
    width: min(100%, 680px);
    margin: 0 auto;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: rgba(10, 17, 35, 0.92);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.5);
  }

  .closeSearch {
    top: 18px;
    right: 18px;
  }
}

@media (max-width: 620px) {
  .shell {
    width: calc(100% - 24px);
    min-height: 66px;
  }

  .logo {
    font-size: 20px;
    letter-spacing: -0.8px;
  }

  .actions {
    gap: 7px;
  }

  .searchButton,
  .mobileButton {
    flex-basis: 42px;
    width: 42px;
    height: 42px;
    min-height: 42px;
    border-radius: 13px;
  }

  .mobileMenu {
    top: 66px;
    padding-top: 14px;
  }

  .mobileMenu a {
    min-height: 52px;
    padding: 0 15px;
    border-radius: 15px;
    font-size: 14px;
  }

  .searchPanel {
    padding: 20px;
    border-radius: 20px;
  }

  .searchPanel h2 {
    font-size: clamp(25px, 8vw, 34px);
    letter-spacing: -1.3px;
  }
}

@media (max-width: 390px) {
  .shell {
    width: calc(100% - 18px);
  }

  .logo {
    font-size: 18px;
  }

  .searchButton,
  .mobileButton {
    flex-basis: 39px;
    width: 39px;
    height: 39px;
    min-height: 39px;
    border-radius: 12px;
    font-size: 16px;
  }

  .mobileMenu {
    padding-right: 12px;
    padding-left: 12px;
  }

  .mobileMenu a {
    min-height: 50px;
    padding-right: 14px;
    padding-left: 14px;
  }
}

@keyframes auftragoMobileMenuIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}



/* =========================================================
   AUFTRAGO MOBILE NAVIGATION V3
   COMPLETE PREMIUM REDESIGN
   ========================================================= */

@media (max-width: 1179px) {

  /* ---------- HEADER ---------- */

  .header {
    position: sticky !important;
    top: 0 !important;
    z-index: 5000 !important;
    width: 100% !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    background:
      radial-gradient(
        circle at 10% -40%,
        rgba(56, 189, 248, 0.18),
        transparent 45%
      ),
      linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.99),
        rgba(4, 8, 20, 0.97)
      ) !important;
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.42),
      inset 0 -1px 0 rgba(255, 255, 255, 0.025) !important;
    backdrop-filter: blur(28px) saturate(145%) !important;
    -webkit-backdrop-filter: blur(28px) saturate(145%) !important;
  }

  .shell {
    width: min(calc(100% - 28px), 1380px) !important;
    min-height: 72px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 14px !important;
  }

  .logo {
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
    min-width: 0 !important;
    color: #ffffff !important;
    font-size: 24px !important;
    font-weight: 950 !important;
    line-height: 1 !important;
    letter-spacing: -1.2px !important;
    text-decoration: none !important;
    white-space: nowrap !important;
  }

  .logo::before {
    content: "🔥" !important;
    width: 43px !important;
    height: 43px !important;
    margin-right: 11px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex: 0 0 43px !important;
    border: 1px solid rgba(251, 113, 133, 0.22) !important;
    border-radius: 15px !important;
    background:
      linear-gradient(
        145deg,
        rgba(127, 29, 29, 0.48),
        rgba(31, 15, 25, 0.85)
      ) !important;
    box-shadow:
      0 10px 25px rgba(239, 68, 68, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
    font-size: 20px !important;
  }

  .desktopNav,
  .primaryButton {
    display: none !important;
  }

  .actions {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    flex: 0 0 auto !important;
    gap: 8px !important;
  }

  .searchButton,
  .mobileButton {
    width: 46px !important;
    min-width: 46px !important;
    height: 46px !important;
    min-height: 46px !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.13) !important;
    border-radius: 15px !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        145deg,
        #38bdf8 0%,
        #4f8df7 48%,
        #6d5dfc 100%
      ) !important;
    box-shadow:
      0 12px 28px rgba(79, 70, 229, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.26) !important;
    font-size: 18px !important;
    font-weight: 950 !important;
    cursor: pointer !important;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      filter 160ms ease !important;
  }

  .searchButton:hover,
  .mobileButton:hover {
    filter: brightness(1.08) !important;
    transform: translateY(-1px) !important;
    box-shadow:
      0 16px 35px rgba(79, 70, 229, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;
  }

  .searchButton:active,
  .mobileButton:active {
    transform: scale(0.94) !important;
  }

  /* ---------- MOBILE FULLSCREEN MENU ---------- */

  .mobileMenu {
    position: fixed !important;
    inset: 72px 0 0 0 !important;
    z-index: 4900 !important;
    width: 100% !important;
    max-width: none !important;
    height: calc(100dvh - 72px) !important;
    margin: 0 !important;
    padding:
      22px
      max(18px, env(safe-area-inset-right))
      max(30px, calc(18px + env(safe-area-inset-bottom)))
      max(18px, env(safe-area-inset-left)) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
    scrollbar-width: thin !important;
    scrollbar-color:
      rgba(96, 165, 250, 0.7)
      rgba(255, 255, 255, 0.04) !important;
    background:
      radial-gradient(
        circle at 5% 0%,
        rgba(14, 165, 233, 0.16),
        transparent 32%
      ),
      radial-gradient(
        circle at 100% 20%,
        rgba(99, 102, 241, 0.18),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        #030712 0%,
        #050a18 55%,
        #07101f 100%
      ) !important;
    border-top: 1px solid rgba(255, 255, 255, 0.06) !important;
    animation: auftragoMenuReveal 230ms ease-out !important;
  }

  .mobileMenu::before {
    content: "AUFTRAGO NAVIGATION" !important;
    display: block !important;
    margin: 0 4px 2px !important;
    color: #7dd3fc !important;
    font-size: 10px !important;
    font-weight: 950 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
  }

  .mobileMenu > a {
    min-height: 54px !important;
    padding: 0 17px !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 16px !important;
    color: rgba(255, 255, 255, 0.92) !important;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.025)
      ) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 12px 28px rgba(0, 0, 0, 0.14) !important;
    font-size: 14px !important;
    font-weight: 850 !important;
    line-height: 1.2 !important;
    text-decoration: none !important;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease !important;
  }

  .mobileMenu > a::after {
    content: "→" !important;
    margin-left: auto !important;
    color: #7dd3fc !important;
    font-size: 17px !important;
    font-weight: 900 !important;
  }

  .mobileMenu > a:hover,
  .mobileMenu > a:focus-visible {
    border-color: rgba(125, 211, 252, 0.35) !important;
    background:
      linear-gradient(
        145deg,
        rgba(56, 189, 248, 0.13),
        rgba(99, 102, 241, 0.13)
      ) !important;
    transform: translateY(-1px) !important;
    outline: none !important;
  }

  /* ---------- SERVICES PANEL ---------- */

  .megaMenu {
    position: static !important;
    inset: auto !important;
    width: 100% !important;
    max-width: none !important;
    margin: 4px 0 !important;
    padding: 0 !important;
    display: block !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    overflow: visible !important;
  }

  .megaMenuInner {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
  }

  .megaIntro {
    position: relative !important;
    padding: 22px !important;
    overflow: hidden !important;
    border: 1px solid rgba(96, 165, 250, 0.16) !important;
    border-radius: 22px !important;
    background:
      radial-gradient(
        circle at 90% 5%,
        rgba(99, 102, 241, 0.25),
        transparent 42%
      ),
      linear-gradient(
        145deg,
        rgba(13, 27, 51, 0.98),
        rgba(9, 17, 34, 0.98)
      ) !important;
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.045) !important;
  }

  .megaIntro::after {
    content: "" !important;
    position: absolute !important;
    width: 145px !important;
    height: 145px !important;
    top: -70px !important;
    right: -55px !important;
    border-radius: 999px !important;
    background: rgba(56, 189, 248, 0.13) !important;
    filter: blur(2px) !important;
    pointer-events: none !important;
  }

  .megaIntro span,
  .megaIntro small {
    position: relative !important;
    z-index: 1 !important;
    color: #7dd3fc !important;
    font-size: 10px !important;
    font-weight: 950 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
  }

  .megaIntro h2 {
    position: relative !important;
    z-index: 1 !important;
    max-width: 540px !important;
    margin: 8px 0 8px !important;
    color: #ffffff !important;
    font-size: clamp(25px, 7vw, 38px) !important;
    font-weight: 950 !important;
    line-height: 1.02 !important;
    letter-spacing: -1.7px !important;
  }

  .megaIntro p {
    position: relative !important;
    z-index: 1 !important;
    max-width: 600px !important;
    margin: 0 !important;
    color: rgba(203, 213, 225, 0.72) !important;
    font-size: 13px !important;
    line-height: 1.65 !important;
  }

  .megaIntro a {
    position: relative !important;
    z-index: 1 !important;
    min-height: 44px !important;
    margin-top: 18px !important;
    padding: 0 16px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 13px !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        135deg,
        #38bdf8,
        #6366f1
      ) !important;
    box-shadow: 0 12px 28px rgba(79, 70, 229, 0.28) !important;
    font-size: 13px !important;
    font-weight: 900 !important;
    text-decoration: none !important;
  }

  .megaGrid {
    display: flex !important;
    flex-direction: column !important;
    grid-template-columns: none !important;
    gap: 10px !important;
  }

  .megaGroup {
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    overflow: hidden !important;
    border: 1px solid rgba(255, 255, 255, 0.075) !important;
    border-radius: 18px !important;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.022)
      ) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 12px 30px rgba(0, 0, 0, 0.13) !important;
  }

  .megaGroup > strong {
    min-height: 58px !important;
    padding: 0 16px !important;
    display: flex !important;
    align-items: center !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        135deg,
        rgba(56, 189, 248, 0.92),
        rgba(99, 102, 241, 0.94)
      ) !important;
    font-size: 14px !important;
    font-weight: 950 !important;
    letter-spacing: -0.2px !important;
    text-transform: none !important;
  }

  .megaGroup > strong::after {
    content: "⌄" !important;
    margin-left: auto !important;
    color: rgba(255, 255, 255, 0.78) !important;
    font-size: 15px !important;
  }

  .megaGroup a {
    min-height: 52px !important;
    padding: 0 16px !important;
    display: flex !important;
    align-items: center !important;
    gap: 11px !important;
    border-top: 1px solid rgba(255, 255, 255, 0.055) !important;
    color: rgba(226, 232, 240, 0.88) !important;
    background: rgba(3, 7, 18, 0.3) !important;
    font-size: 13px !important;
    font-weight: 760 !important;
    text-decoration: none !important;
    transition:
      background 160ms ease,
      color 160ms ease,
      padding-left 160ms ease !important;
  }

  .megaGroup a::after {
    content: "→" !important;
    margin-left: auto !important;
    color: rgba(125, 211, 252, 0.8) !important;
    font-size: 15px !important;
  }

  .megaGroup a:hover,
  .megaGroup a:focus-visible {
    padding-left: 20px !important;
    color: #ffffff !important;
    background: rgba(56, 189, 248, 0.08) !important;
    outline: none !important;
  }

  /* ---------- REGION PANEL ---------- */

  .regionMenu {
    position: static !important;
    inset: auto !important;
    width: 100% !important;
    max-width: none !important;
    margin: 2px 0 !important;
    padding: 18px !important;
    display: block !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 20px !important;
    background:
      linear-gradient(
        145deg,
        rgba(13, 24, 45, 0.97),
        rgba(7, 13, 27, 0.98)
      ) !important;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.2) !important;
  }

  .regionGrid {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 9px !important;
  }

  .regionGrid a {
    min-height: 48px !important;
    padding: 0 13px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    border: 1px solid rgba(255, 255, 255, 0.075) !important;
    border-radius: 13px !important;
    color: rgba(255, 255, 255, 0.88) !important;
    background: rgba(255, 255, 255, 0.035) !important;
    font-size: 12px !important;
    font-weight: 850 !important;
    text-decoration: none !important;
  }

  .regionGrid a::after {
    content: "↗" !important;
    color: #7dd3fc !important;
  }

  /* ---------- SEARCH OVERLAY ---------- */

  .searchOverlay {
    position: fixed !important;
    inset: 0 !important;
    z-index: 6000 !important;
    width: 100% !important;
    min-height: 100dvh !important;
    padding:
      86px
      max(18px, env(safe-area-inset-right))
      max(32px, env(safe-area-inset-bottom))
      max(18px, env(safe-area-inset-left)) !important;
    overflow-y: auto !important;
    background:
      radial-gradient(
        circle at 10% 0%,
        rgba(56, 189, 248, 0.2),
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 15%,
        rgba(99, 102, 241, 0.22),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        #02050d,
        #040916 55%,
        #07101f
      ) !important;
    backdrop-filter: blur(30px) !important;
    -webkit-backdrop-filter: blur(30px) !important;
    animation: auftragoSearchReveal 220ms ease-out !important;
  }

  .closeSearch {
    position: fixed !important;
    top: 18px !important;
    right: max(18px, env(safe-area-inset-right)) !important;
    z-index: 6100 !important;
    width: 48px !important;
    height: 48px !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    border-radius: 15px !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        145deg,
        #38bdf8,
        #6366f1
      ) !important;
    box-shadow:
      0 15px 34px rgba(79, 70, 229, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.24) !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    cursor: pointer !important;
  }

  .searchPanel {
    width: min(100%, 720px) !important;
    max-width: 720px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  .searchEyebrow {
    display: block !important;
    margin-bottom: 14px !important;
    color: #7dd3fc !important;
    font-size: 11px !important;
    font-weight: 950 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
  }

  .searchPanel h2 {
    max-width: 660px !important;
    margin: 0 0 30px !important;
    color: #ffffff !important;
    font-size: clamp(38px, 8vw, 68px) !important;
    font-weight: 950 !important;
    line-height: 0.98 !important;
    letter-spacing: -3px !important;
  }

  .searchPanel form {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    gap: 10px !important;
    margin-bottom: 22px !important;
  }

  .searchPanel input {
    width: 100% !important;
    min-width: 0 !important;
    min-height: 58px !important;
    padding: 0 18px !important;
    border: 1px solid rgba(125, 211, 252, 0.28) !important;
    border-radius: 16px !important;
    outline: none !important;
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.055) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 12px 30px rgba(0, 0, 0, 0.16) !important;
    font-size: 15px !important;
  }

  .searchPanel input::placeholder {
    color: rgba(148, 163, 184, 0.75) !important;
  }

  .searchPanel input:focus {
    border-color: rgba(56, 189, 248, 0.7) !important;
    box-shadow:
      0 0 0 4px rgba(56, 189, 248, 0.1),
      0 14px 34px rgba(0, 0, 0, 0.2) !important;
  }

  .searchPanel form button {
    min-width: 112px !important;
    min-height: 58px !important;
    padding: 0 20px !important;
    border: 0 !important;
    border-radius: 16px !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        135deg,
        #38bdf8,
        #6366f1
      ) !important;
    box-shadow:
      0 14px 32px rgba(79, 70, 229, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.22) !important;
    font-size: 14px !important;
    font-weight: 950 !important;
    cursor: pointer !important;
  }

  .searchResults {
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
  }

  .searchResults a {
    min-height: 70px !important;
    padding: 12px 16px !important;
    display: grid !important;
    grid-template-columns: 46px minmax(0, 1fr) auto !important;
    align-items: center !important;
    gap: 13px !important;
    border: 1px solid rgba(255, 255, 255, 0.085) !important;
    border-radius: 18px !important;
    color: #ffffff !important;
    background:
      linear-gradient(
        135deg,
        rgba(56, 189, 248, 0.88),
        rgba(99, 102, 241, 0.92)
      ) !important;
    box-shadow:
      0 14px 34px rgba(30, 64, 175, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.18) !important;
    text-decoration: none !important;
    transition:
      transform 160ms ease,
      filter 160ms ease,
      box-shadow 160ms ease !important;
  }

  .searchResults a:hover {
    filter: brightness(1.08) !important;
    transform: translateY(-2px) !important;
    box-shadow:
      0 18px 40px rgba(30, 64, 175, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.22) !important;
  }

  .searchResults a > span {
    width: 46px !important;
    height: 46px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.17) !important;
    border-radius: 14px !important;
    background: rgba(255, 255, 255, 0.1) !important;
    font-size: 21px !important;
  }

  .searchResults strong {
    display: block !important;
    margin-bottom: 4px !important;
    color: #ffffff !important;
    font-size: 14px !important;
    font-weight: 950 !important;
  }

  .searchResults small {
    display: block !important;
    color: rgba(15, 23, 42, 0.58) !important;
    font-size: 11px !important;
    font-weight: 750 !important;
  }

  .searchResults b {
    color: rgba(255, 255, 255, 0.78) !important;
    font-size: 18px !important;
  }
}

/* ---------- SMALL MOBILE ---------- */

@media (max-width: 620px) {

  .shell {
    width: calc(100% - 22px) !important;
    min-height: 66px !important;
  }

  .logo {
    font-size: 20px !important;
    letter-spacing: -0.9px !important;
  }

  .logo::before {
    width: 39px !important;
    height: 39px !important;
    margin-right: 9px !important;
    flex-basis: 39px !important;
    border-radius: 13px !important;
    font-size: 18px !important;
  }

  .searchButton,
  .mobileButton {
    width: 42px !important;
    min-width: 42px !important;
    height: 42px !important;
    min-height: 42px !important;
    border-radius: 13px !important;
    font-size: 16px !important;
  }

  .mobileMenu {
    inset: 66px 0 0 0 !important;
    height: calc(100dvh - 66px) !important;
    padding:
      16px
      13px
      max(26px, calc(16px + env(safe-area-inset-bottom))) !important;
    gap: 9px !important;
  }

  .mobileMenu > a {
    min-height: 51px !important;
    padding: 0 15px !important;
    border-radius: 15px !important;
    font-size: 13px !important;
  }

  .megaIntro {
    padding: 19px !important;
    border-radius: 19px !important;
  }

  .megaIntro h2 {
    font-size: clamp(26px, 9vw, 36px) !important;
  }

  .megaGroup {
    border-radius: 16px !important;
  }

  .megaGroup > strong {
    min-height: 55px !important;
    padding: 0 14px !important;
    font-size: 13px !important;
  }

  .megaGroup a {
    min-height: 50px !important;
    padding: 0 14px !important;
    font-size: 12px !important;
  }

  .regionGrid {
    grid-template-columns: 1fr !important;
  }

  .searchOverlay {
    padding:
      82px
      14px
      max(28px, env(safe-area-inset-bottom)) !important;
  }

  .closeSearch {
    top: 15px !important;
    right: 14px !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 14px !important;
  }

  .searchPanel h2 {
    margin-bottom: 24px !important;
    font-size: clamp(37px, 12vw, 54px) !important;
    letter-spacing: -2.4px !important;
  }

  .searchPanel form {
    grid-template-columns: 1fr !important;
  }

  .searchPanel form button {
    width: 100% !important;
  }

  .searchResults a {
    min-height: 66px !important;
    grid-template-columns: 42px minmax(0, 1fr) auto !important;
    gap: 11px !important;
    border-radius: 16px !important;
  }

  .searchResults a > span {
    width: 42px !important;
    height: 42px !important;
    border-radius: 13px !important;
  }
}

@media (max-width: 380px) {

  .logo {
    font-size: 18px !important;
  }

  .logo::before {
    width: 36px !important;
    height: 36px !important;
    flex-basis: 36px !important;
    margin-right: 8px !important;
  }

  .actions {
    gap: 6px !important;
  }

  .searchButton,
  .mobileButton {
    width: 39px !important;
    min-width: 39px !important;
    height: 39px !important;
    min-height: 39px !important;
  }
}

/* ---------- ANIMATIONS ---------- */

@keyframes auftragoMenuReveal {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes auftragoSearchReveal {
  from {
    opacity: 0;
    transform: scale(0.985);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

