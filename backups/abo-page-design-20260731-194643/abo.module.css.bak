.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 42px 24px 100px;
  color: #f8f5ed;
  background:
    radial-gradient(
      circle at 14% 0%,
      rgba(215, 163, 48, 0.13),
      transparent 29%
    ),
    radial-gradient(
      circle at 88% 20%,
      rgba(215, 163, 48, 0.065),
      transparent 24%
    ),
    #05070a;
}

.backgroundGlow {
  position: absolute;
  top: -320px;
  left: 50%;
  width: 900px;
  height: 600px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(218, 166, 51, 0.08);
  filter: blur(110px);
  pointer-events: none;
}

.container {
  position: relative;
  z-index: 2;
  width: min(1320px, 100%);
  margin: 0 auto;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 40px;
  padding: 50px;
  border: 1px solid rgba(224, 177, 72, 0.21);
  border-radius: 28px;
  background:
    linear-gradient(
      135deg,
      rgba(17, 21, 27, 0.98),
      rgba(7, 10, 14, 0.98)
    );
  box-shadow: 0 35px 100px rgba(0, 0, 0, 0.37);
}

.heroContent {
  max-width: 900px;
}

.eyebrow {
  display: inline-flex;
  color: #e9bd5b;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 18px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(48px, 7vw, 92px);
  font-weight: 400;
  line-height: 0.95;
  letter-spacing: -0.055em;
}

.hero h1 em {
  display: block;
  color: #e8ba54;
  font-style: normal;
}

.hero p {
  max-width: 690px;
  margin: 26px 0 0;
  color: #8f96a1;
  font-size: 16px;
  line-height: 1.75;
}

.backButton {
  flex-shrink: 0;
  padding: 14px 18px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  color: #f6f3ec;
  background: rgba(255, 255, 255, 0.03);
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
  transition:
    transform 160ms ease,
    border-color 160ms ease;
}

.backButton:hover {
  transform: translateY(-2px);
  border-color: rgba(232, 185, 79, 0.35);
}

.successMessage,
.noticeMessage,
.errorMessage {
  margin-top: 20px;
  padding: 17px 20px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 800;
}

.successMessage {
  border: 1px solid rgba(95, 211, 133, 0.25);
  color: #a7efbd;
  background: rgba(42, 140, 75, 0.12);
}

.noticeMessage {
  border: 1px solid rgba(230, 181, 70, 0.25);
  color: #f1ce7b;
  background: rgba(144, 103, 20, 0.12);
}

.errorMessage {
  border: 1px solid rgba(235, 98, 98, 0.25);
  color: #ffc0c0;
  background: rgba(161, 48, 48, 0.12);
}

.statusGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-top: 24px;
}

.statusCard {
  min-height: 185px;
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 21px;
  background:
    linear-gradient(
      145deg,
      rgba(15, 19, 25, 0.97),
      rgba(8, 11, 15, 0.97)
    );
}

.statusCard > span {
  color: #7f8792;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.statusCard > strong {
  display: block;
  margin-top: 19px;
  color: #fffdf8;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(30px, 4vw, 49px);
  font-weight: 400;
  line-height: 1.03;
}

.statusCard .activeStatus {
  color: #7fe39d;
}

.statusCard .pendingStatus {
  color: #efc568;
}

.statusCard .dateValue {
  font-size: clamp(25px, 3vw, 39px);
}

.statusCard small {
  display: block;
  margin-top: 14px;
  color: #737b86;
  font-size: 12px;
}

.membership {
  display: grid;
  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(340px, 0.75fr);
  gap: 18px;
  margin-top: 24px;
}

.membershipContent,
.priceCard {
  padding: 46px;
  border: 1px solid rgba(226, 178, 68, 0.18);
  border-radius: 25px;
  background:
    linear-gradient(
      145deg,
      rgba(15, 19, 25, 0.98),
      rgba(7, 10, 14, 0.98)
    );
}

.membershipContent h2 {
  margin: 17px 0 0;
  color: #fffdf8;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(45px, 6vw, 78px);
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -0.05em;
}

.membershipContent > p {
  max-width: 690px;
  margin: 25px 0 0;
  color: #8d949f;
  line-height: 1.75;
}

.features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 32px;
}

.features div {
  padding: 14px 15px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  color: #c6c9ce;
  background: rgba(255, 255, 255, 0.025);
  font-size: 13px;
  font-weight: 750;
}

.features div::before {
  content: "✓";
  margin-right: 9px;
  color: #e8b94f;
}

.priceCard {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(229, 180, 68, 0.15),
      transparent 37%
    ),
    linear-gradient(
      145deg,
      rgba(23, 20, 14, 0.99),
      rgba(7, 9, 12, 0.99)
    );
}

.priceCard > span {
  color: #e7b94f;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.priceCard > strong {
  display: block;
  margin-top: 18px;
  color: #f4d47b;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(51px, 6vw, 76px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.05em;
}

.priceCard > small {
  display: block;
  margin-top: 12px;
  color: #858c97;
  line-height: 1.55;
}

.priceCard form {
  margin-top: 15px;
}

.primaryButton,
.secondaryButton {
  width: 100%;
  min-height: 57px;
  border-radius: 13px;
  font-size: 14px;
  font-weight: 900;
  cursor: pointer;
  transition:
    transform 160ms ease,
    filter 160ms ease;
}

.primaryButton:hover,
.secondaryButton:hover {
  transform: translateY(-2px);
}

.primaryButton {
  margin-top: 22px;
  border: 1px solid #e8bb54;
  color: #171005;
  background:
    linear-gradient(
      110deg,
      #b87c1c,
      #f4d476,
      #c58c26
    );
  box-shadow: 0 16px 42px rgba(211, 156, 37, 0.2);
}

.primaryButton:hover {
  filter: brightness(1.06);
}

.secondaryButton {
  border: 1px solid rgba(232, 185, 79, 0.3);
  color: #edca76;
  background: rgba(222, 171, 56, 0.04);
}

.exemptBox {
  margin-top: 28px;
  padding: 18px;
  border: 1px solid rgba(103, 218, 139, 0.2);
  border-radius: 13px;
  color: #a8eabc;
  background: rgba(49, 142, 76, 0.1);
  font-size: 13px;
  line-height: 1.65;
}

.infoGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-top: 24px;
}

.infoGrid article {
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.022);
}

.infoGrid article > span {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 1px solid rgba(231, 183, 75, 0.28);
  border-radius: 50%;
  color: #e9bd5b;
  font-size: 11px;
  font-weight: 900;
}

.infoGrid h3 {
  margin: 18px 0 0;
  color: #f8f5ed;
  font-size: 17px;
}

.infoGrid p {
  margin: 10px 0 0;
  color: #858c96;
  font-size: 13px;
  line-height: 1.65;
}

@media (max-width: 950px) {
  .hero {
    flex-direction: column;
  }

  .statusGrid,
  .infoGrid {
    grid-template-columns: 1fr;
  }

  .membership {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .page {
    padding: 16px 12px 60px;
  }

  .hero,
  .membershipContent,
  .priceCard {
    padding: 28px 23px;
    border-radius: 21px;
  }

  .hero h1 {
    font-size: 50px;
  }

  .backButton {
    width: 100%;
    text-align: center;
  }

  .features {
    grid-template-columns: 1fr;
  }

  .membershipContent h2 {
    font-size: 48px;
  }
}
