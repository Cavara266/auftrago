.page {
  --bg: #03050a;
  --surface: rgba(10, 15, 25, 0.84);
  --surface-strong: rgba(12, 19, 32, 0.96);
  --line: rgba(255, 255, 255, 0.09);
  --line-bright: rgba(109, 202, 255, 0.2);
  --text: #f7f9fc;
  --muted: #8e9bae;
  --cyan: #55d6ff;
  --blue: #5e7cff;
  --purple: #aa63ff;
  --green: #65edaa;
  --gold: #ffd65c;

  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: var(--text);
  background:
    radial-gradient(circle at 15% 5%, rgba(35, 123, 255, 0.16), transparent 30%),
    radial-gradient(circle at 90% 25%, rgba(153, 67, 255, 0.13), transparent 28%),
    radial-gradient(circle at 50% 70%, rgba(0, 186, 255, 0.07), transparent 35%),
    linear-gradient(145deg, #02040a, #050816 48%, #03040a);
}

.noise {
  position: fixed;
  inset: 0;
  z-index: 50;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.9'/%3E%3C/svg%3E");
}

.orbOne,
.orbTwo {
  position: absolute;
  border-radius: 50%;
  filter: blur(110px);
  pointer-events: none;
  animation: orbFloat 9s ease-in-out infinite;
}

.orbOne {
  top: 580px;
  left: -220px;
  width: 520px;
  height: 520px;
  background: rgba(42, 151, 255, 0.12);
}

.orbTwo {
  top: 1450px;
  right: -240px;
  width: 600px;
  height: 600px;
  background: rgba(160, 70, 255, 0.1);
  animation-delay: -4s;
}

.header {
  position: relative;
  z-index: 20;
  display: grid;
  width: min(1440px, calc(100% - 48px));
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 30px;
  margin: 0 auto;
  padding: 22px 0;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: white;
  text-decoration: none;
}

.logo span {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid rgba(255, 111, 55, 0.28);
  border-radius: 15px;
  background: linear-gradient(145deg, rgba(255, 89, 30, 0.2), rgba(255, 188, 52, 0.08));
  box-shadow: 0 0 32px rgba(255, 80, 30, 0.14);
}

.logo strong {
  font-size: 21px;
  letter-spacing: -0.04em;
}

.header nav {
  display: flex;
  align-items: center;
  gap: 30px;
}

.header nav a,
.headerActions > a:first-child {
  color: #96a1b3;
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
  transition: color 160ms ease;
}

.header nav a:hover,
.headerActions > a:first-child:hover {
  color: white;
}

.headerActions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 17px;
}

.headerActions > a:last-child {
  display: inline-flex;
  min-height: 45px;
  align-items: center;
  justify-content: center;
  padding: 11px 17px;
  border: 1px solid rgba(85, 214, 255, 0.25);
  border-radius: 13px;
  color: #eafaff;
  background: rgba(85, 214, 255, 0.08);
  font-size: 12px;
  font-weight: 850;
  text-decoration: none;
}

.hero {
  position: relative;
  z-index: 2;
  display: grid;
  width: min(1440px, calc(100% - 48px));
  min-height: 780px;
  grid-template-columns: minmax(0, 0.9fr) minmax(550px, 1.1fr);
  align-items: center;
  gap: 35px;
  margin: 18px auto 0;
}

.heroContent {
  position: relative;
  z-index: 4;
  padding: 55px 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #a6ddff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.eyebrow i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 18px rgba(101, 237, 170, 0.85);
  animation: pulse 2s ease-in-out infinite;
}

.hero h1 {
  max-width: 780px;
  margin: 25px 0 0;
  color: white;
  font-size: clamp(68px, 7.3vw, 112px);
  font-weight: 850;
  line-height: 0.87;
  letter-spacing: -0.075em;
}

.hero h1 span {
  display: block;
  color: transparent;
  background: linear-gradient(90deg, var(--cyan), #8492ff 52%, #c067ff);
  background-clip: text;
  -webkit-background-clip: text;
}

.heroContent > p {
  max-width: 700px;
  margin: 30px 0 0;
  color: #98a6ba;
  font-size: 17px;
  line-height: 1.75;
}

.heroTrust {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 27px;
}

.heroTrust span {
  display: inline-flex;
  min-height: 39px;
  align-items: center;
  gap: 8px;
  padding: 8px 13px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: #cbd3df;
  background: rgba(255, 255, 255, 0.035);
  font-size: 11px;
  font-weight: 750;
  backdrop-filter: blur(18px);
}

.heroTrust b {
  color: var(--green);
}

.heroButtons {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 29px;
}

.mainButton,
.ghostButton {
  display: inline-flex;
  min-height: 57px;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 14px 22px;
  border-radius: 15px;
  font-size: 13px;
  font-weight: 900;
  text-decoration: none;
}

.mainButton {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(119, 220, 255, 0.48);
  color: #06111c;
  background: linear-gradient(110deg, #42caff, #6a8cff 53%, #ad5eff);
  box-shadow: 0 18px 55px rgba(66, 169, 255, 0.25);
  transition: transform 170ms ease, box-shadow 170ms ease;
}

.mainButton::before {
  content: "";
  position: absolute;
  top: -20%;
  bottom: -20%;
  left: -50%;
  width: 35%;
  transform: skewX(-20deg);
  background: rgba(255, 255, 255, 0.45);
  filter: blur(8px);
  animation: buttonShine 3.2s ease-in-out infinite;
}

.mainButton:hover {
  transform: translateY(-3px) scale(1.015);
  box-shadow: 0 25px 70px rgba(66, 169, 255, 0.34);
}

.ghostButton {
  border: 1px solid var(--line);
  color: #dbe3ee;
  background: rgba(255, 255, 255, 0.035);
  backdrop-filter: blur(18px);
  transition: transform 170ms ease, border-color 170ms ease;
}

.ghostButton:hover {
  transform: translateY(-3px);
  border-color: rgba(85, 214, 255, 0.25);
}

.microProof {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 34px;
}

.microProof > div {
  display: flex;
}

.microProof > div span {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  margin-left: -7px;
  border: 2px solid #07101e;
  border-radius: 50%;
  color: white;
  background: linear-gradient(145deg, #1d3049, #0d1524);
  font-size: 9px;
  font-weight: 900;
}

.microProof > div span:first-child {
  margin-left: 0;
}

.microProof p {
  display: grid;
  gap: 4px;
  margin: 0;
  color: #748196;
  font-size: 10px;
}

.microProof strong {
  color: #dce3ec;
}

.productStage {
  position: relative;
  min-height: 650px;
  perspective: 1600px;
}

.stageGlow {
  position: absolute;
  inset: 10% 0 5%;
  border-radius: 50%;
  background:
    radial-gradient(circle at 45% 35%, rgba(64, 196, 255, 0.2), transparent 38%),
    radial-gradient(circle at 70% 60%, rgba(150, 83, 255, 0.18), transparent 42%);
  filter: blur(65px);
  animation: glowPulse 6s ease-in-out infinite;
}

.dashboardWindow {
  position: absolute;
  top: 75px;
  right: -80px;
  width: min(850px, 108%);
  overflow: hidden;
  transform: rotateY(-8deg) rotateX(3deg);
  border: 1px solid rgba(132, 214, 255, 0.22);
  border-radius: 26px;
  background: rgba(6, 11, 22, 0.94);
  box-shadow:
    -30px 55px 120px rgba(0, 0, 0, 0.55),
    0 0 80px rgba(58, 148, 255, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(28px);
  animation: dashboardFloat 7s ease-in-out infinite;
}

.dashboardTopbar {
  display: flex;
  height: 61px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 22px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.025);
}

.windowDots {
  display: flex;
  gap: 6px;
}

.windowDots span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff6c60;
}

.windowDots span:nth-child(2) {
  background: #ffca55;
}

.windowDots span:nth-child(3) {
  background: #65d879;
}

.dashboardBrand {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #e8edf5;
  font-size: 11px;
  font-weight: 850;
}

.dashboardBrand i {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 9px;
  color: #dff8ff;
  background: linear-gradient(145deg, rgba(55, 185, 255, 0.25), rgba(129, 84, 255, 0.25));
  font-style: normal;
}

.demoBadge {
  padding: 6px 9px;
  border: 1px solid rgba(101, 237, 170, 0.2);
  border-radius: 999px;
  color: #8df1b8;
  background: rgba(101, 237, 170, 0.06);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.dashboardBody {
  display: grid;
  min-height: 500px;
  grid-template-columns: 155px 1fr;
}

.dashboardSidebar {
  display: grid;
  align-content: start;
  gap: 9px;
  padding: 22px 15px;
  border-right: 1px solid var(--line);
  background: rgba(6, 11, 22, 0.7);
}

.dashboardSidebar span {
  padding: 11px;
  border-radius: 9px;
  color: #64728a;
  font-size: 9px;
  font-weight: 750;
}

.dashboardSidebar .sidebarActive {
  color: #dff6ff;
  background: linear-gradient(90deg, rgba(53, 184, 255, 0.14), rgba(113, 87, 255, 0.08));
}

.dashboardContent {
  padding: 26px;
}

.dashboardWelcome {
  padding: 22px;
  border: 1px solid rgba(104, 191, 255, 0.12);
  border-radius: 17px;
  background: linear-gradient(145deg, rgba(25, 58, 101, 0.28), rgba(32, 24, 86, 0.18));
}

.dashboardWelcome span {
  color: #72dfff;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
}

.dashboardWelcome strong {
  display: block;
  margin-top: 8px;
  font-size: 19px;
}

.dashboardWelcome p {
  margin: 7px 0 0;
  color: #75839a;
  font-size: 9px;
}

.miniStats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
  margin-top: 12px;
}

.miniStats article {
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.025);
}

.miniStats span,
.leadValue span {
  color: #65738a;
  font-size: 7px;
  font-weight: 900;
  text-transform: uppercase;
}

.miniStats strong {
  display: block;
  margin-top: 7px;
  font-size: 16px;
}

.miniStats small {
  display: block;
  margin-top: 4px;
  color: #606c7f;
  font-size: 7px;
}

.liveLeadArea {
  margin-top: 12px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.02);
}

.leadAreaHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.leadAreaHeading > div {
  display: grid;
  gap: 4px;
}

.leadAreaHeading span {
  color: #6de9a5;
  font-size: 7px;
  font-weight: 900;
  text-transform: uppercase;
}

.leadAreaHeading strong {
  font-size: 11px;
}

.leadAreaHeading i {
  padding: 5px 8px;
  border-radius: 999px;
  color: #6edcff;
  background: rgba(76, 200, 255, 0.08);
  font-size: 6px;
  font-style: normal;
  font-weight: 900;
}

.animatedLeadCard {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  align-items: center;
  gap: 13px;
  margin-top: 13px;
  padding: 14px;
  border: 1px solid rgba(100, 207, 255, 0.15);
  border-radius: 13px;
  background:
    radial-gradient(circle at 0% 50%, rgba(64, 190, 255, 0.09), transparent 40%),
    rgba(255, 255, 255, 0.025);
  animation: leadEnter 500ms cubic-bezier(.2,.9,.2,1);
}

.leadCardIcon {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 11px;
  color: #b9f3ff;
  background: linear-gradient(145deg, rgba(59, 193, 255, 0.2), rgba(124, 83, 255, 0.18));
}

.leadCardCopy {
  display: grid;
  gap: 3px;
}

.leadCardCopy span {
  color: #6edcff;
  font-size: 6px;
  font-weight: 900;
  text-transform: uppercase;
}

.leadCardCopy strong {
  font-size: 10px;
}

.leadCardCopy small {
  color: #69768b;
  font-size: 7px;
}

.leadValue {
  display: grid;
  gap: 4px;
  text-align: right;
}

.leadValue strong {
  font-size: 10px;
}

.animatedLeadCard button {
  min-height: 33px;
  padding: 8px 11px;
  border: 1px solid rgba(91, 207, 255, 0.17);
  border-radius: 9px;
  color: #dff8ff;
  background: rgba(68, 190, 255, 0.08);
  font-size: 7px;
  font-weight: 900;
}

.activityTicker {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 11px;
  padding: 9px 11px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.02);
}

.tickerPulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 13px rgba(101, 237, 170, 0.7);
  animation: pulse 1.7s ease-in-out infinite;
}

.activityTicker p {
  margin: 0;
  color: #78869a;
  font-size: 7px;
  animation: tickerEnter 400ms ease;
}

.floatingChipOne,
.floatingChipTwo {
  position: absolute;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, 0.11);
  border-radius: 13px;
  color: #e9f0f9;
  background: rgba(10, 17, 31, 0.82);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px);
  font-size: 9px;
  font-weight: 800;
}

.floatingChipOne {
  top: 40px;
  left: 3%;
  animation: chipFloatOne 5s ease-in-out infinite;
}

.floatingChipTwo {
  right: 2%;
  bottom: 70px;
  animation: chipFloatTwo 5.5s ease-in-out infinite;
}

.floatingChipOne span {
  color: var(--cyan);
}

.floatingChipTwo span {
  color: var(--green);
}

.mobileLeadPreview {
  display: none;
}

.scrollingBar {
  position: relative;
  z-index: 3;
  width: 100%;
  overflow: hidden;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.025);
}

.scrollingBar > div {
  display: flex;
  width: max-content;
  align-items: center;
  gap: 28px;
  padding: 15px 0;
  animation: marquee 23s linear infinite;
}

.scrollingBar span {
  color: #92a0b5;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.scrollingBar i {
  color: #5ed8ff;
  font-size: 7px;
}

.stats {
  position: relative;
  z-index: 2;
  display: grid;
  width: min(1280px, calc(100% - 48px));
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 24px auto 0;
}

.stats article {
  padding: 26px;
  border: 1px solid var(--line);
  border-radius: 19px;
  background: rgba(10, 16, 28, 0.72);
  backdrop-filter: blur(18px);
}

.stats strong {
  display: block;
  font-size: 33px;
  letter-spacing: -0.05em;
}

.stats span {
  display: block;
  margin-top: 6px;
  color: #d5dce6;
  font-size: 10px;
  font-weight: 800;
}

.stats small {
  display: block;
  margin-top: 4px;
  color: #647187;
  font-size: 8px;
}

.platformSection,
.benefitSection,
.processSection,
.faqSection {
  position: relative;
  z-index: 2;
  width: min(1280px, calc(100% - 48px));
  margin: 120px auto 0;
}

.sectionCopy,
.sectionHeading {
  max-width: 850px;
}

.sectionCopy > span,
.sectionHeading > span,
.roiCopy > span {
  color: #69dfff;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.sectionCopy h2,
.sectionHeading h2,
.roiCopy h2,
.registrationCopy h2,
.finalCta h2 {
  margin: 18px 0 0;
  font-size: clamp(47px, 6vw, 79px);
  line-height: 0.97;
  letter-spacing: -0.065em;
}

.sectionCopy h2 em,
.sectionHeading h2 em,
.registrationCopy h2 em {
  color: transparent;
  background: linear-gradient(90deg, var(--cyan), #8e80ff, #be64ff);
  background-clip: text;
  -webkit-background-clip: text;
  font-style: normal;
}

.sectionCopy p {
  max-width: 720px;
  margin: 23px 0 0;
  color: var(--muted);
  line-height: 1.75;
}

.platformVisual {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 0.65fr 1fr;
  align-items: center;
  gap: 22px;
  margin-top: 45px;
  padding: 50px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 30px;
  background: rgba(7, 12, 23, 0.82);
}

.visualGlow {
  position: absolute;
  inset: 10%;
  background: radial-gradient(circle, rgba(68, 185, 255, 0.12), transparent 48%);
  filter: blur(55px);
  animation: glowPulse 6s ease-in-out infinite;
}

.visualColumn {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 15px;
}

.visualColumn article {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.025);
  transition: transform 180ms ease, border-color 180ms ease;
}

.visualColumn article:hover {
  transform: translateY(-5px);
  border-color: rgba(85, 214, 255, 0.23);
}

.visualColumn span {
  color: #65dfff;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
}

.visualColumn strong {
  display: block;
  margin-top: 9px;
  font-size: 14px;
}

.visualColumn small {
  display: block;
  margin-top: 7px;
  color: #67758b;
  font-size: 9px;
}

.centralFlow {
  position: relative;
  z-index: 2;
  display: grid;
  min-height: 220px;
  place-content: center;
  overflow: hidden;
  border: 1px solid rgba(92, 206, 255, 0.22);
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(76, 200, 255, 0.16), transparent 55%),
    rgba(255, 255, 255, 0.025);
  text-align: center;
  box-shadow: 0 0 70px rgba(65, 159, 255, 0.12);
  animation: centralFloat 5s ease-in-out infinite;
}

.centralFlow span {
  color: #6ee1ff;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.centralFlow strong {
  margin-top: 7px;
  font-size: 15px;
}

.centralFlow i {
  position: absolute;
  inset: 10px;
  border: 1px dashed rgba(91, 210, 255, 0.13);
  border-radius: 50%;
  animation: rotate 18s linear infinite;
}

.benefitGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 42px;
}

.benefitGrid article {
  position: relative;
  min-height: 270px;
  overflow: hidden;
  padding: 27px;
  border: 1px solid var(--line);
  border-radius: 21px;
  background: rgba(10, 16, 28, 0.74);
  transition: transform 180ms ease, border-color 180ms ease;
}

.benefitGrid article::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -70px;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: rgba(72, 197, 255, 0.07);
  filter: blur(35px);
}

.benefitGrid article:hover {
  transform: translateY(-7px);
  border-color: rgba(96, 213, 255, 0.23);
}

.benefitGrid article > span {
  color: #5b6980;
  font-size: 9px;
  font-weight: 900;
}

.benefitGrid article > div {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  margin-top: 34px;
  border: 1px solid rgba(89, 210, 255, 0.18);
  border-radius: 14px;
  color: #9be9ff;
  background: rgba(78, 194, 255, 0.07);
}

.benefitGrid h3 {
  margin: 24px 0 0;
  font-size: 18px;
}

.benefitGrid p {
  margin: 11px 0 0;
  color: #77859a;
  font-size: 11px;
  line-height: 1.7;
}

.roiSection {
  position: relative;
  z-index: 2;
  display: grid;
  width: min(1280px, calc(100% - 48px));
  grid-template-columns: 1fr 0.9fr;
  align-items: center;
  gap: 55px;
  margin: 120px auto 0;
  padding: 55px;
  border: 1px solid rgba(95, 208, 255, 0.17);
  border-radius: 29px;
  background:
    radial-gradient(circle at 80% 20%, rgba(103, 81, 255, 0.12), transparent 34%),
    rgba(8, 13, 24, 0.85);
}

.roiCopy h2 {
  font-size: clamp(41px, 5vw, 66px);
}

.roiCopy p {
  margin: 22px 0 0;
  color: var(--muted);
  line-height: 1.75;
}

.roiCalculation {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 14px;
}

.roiCalculation article {
  min-height: 185px;
  padding: 25px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.025);
}

.roiCalculation span {
  color: #6adfff;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
}

.roiCalculation strong {
  display: block;
  margin-top: 25px;
  font-size: 30px;
  letter-spacing: -0.05em;
}

.roiCalculation small {
  display: block;
  margin-top: 8px;
  color: #68768c;
  font-size: 9px;
}

.roiArrow {
  color: #72dfff;
  font-size: 24px;
  animation: arrowMove 1.6s ease-in-out infinite;
}

.processTrack {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  align-items: center;
  gap: 13px;
  margin-top: 44px;
}

.processTrack article {
  min-height: 220px;
  padding: 25px;
  border: 1px solid var(--line);
  border-radius: 19px;
  background: rgba(10, 16, 28, 0.72);
}

.processTrack article span {
  color: #6edfff;
  font-size: 9px;
  font-weight: 900;
}

.processTrack h3 {
  margin: 55px 0 0;
  font-size: 17px;
}

.processTrack p {
  margin: 10px 0 0;
  color: #748297;
  font-size: 10px;
  line-height: 1.65;
}

.processTrack > i {
  width: 34px;
  height: 1px;
  background: linear-gradient(90deg, rgba(89, 210, 255, 0.1), rgba(89, 210, 255, 0.6));
  animation: lineGlow 2s ease-in-out infinite;
}

.registration {
  position: relative;
  z-index: 2;
  display: grid;
  width: min(1280px, calc(100% - 48px));
  grid-template-columns: 0.8fr 1.2fr;
  gap: 50px;
  align-items: start;
  margin: 120px auto 0;
  padding: 55px;
  border: 1px solid rgba(95, 208, 255, 0.19);
  border-radius: 30px;
  background:
    radial-gradient(circle at 10% 15%, rgba(53, 181, 255, 0.11), transparent 35%),
    radial-gradient(circle at 90% 90%, rgba(154, 78, 255, 0.11), transparent 32%),
    rgba(7, 12, 23, 0.92);
}

.registrationCopy {
  position: sticky;
  top: 30px;
}

.registrationBadge {
  display: inline-flex;
  padding: 8px 11px;
  border: 1px solid rgba(101, 237, 170, 0.23);
  border-radius: 999px;
  color: #91efb8;
  background: rgba(101, 237, 170, 0.07);
  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
}

.registrationCopy p {
  margin: 22px 0 0;
  color: var(--muted);
  line-height: 1.75;
}

.priceSummary {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 11px 25px;
  margin-top: 27px;
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.025);
}

.priceSummary span {
  color: #78869a;
  font-size: 10px;
}

.priceSummary strong {
  color: white;
  font-size: 12px;
}

.registrationCopy ul {
  display: grid;
  gap: 11px;
  margin: 25px 0 0;
  padding: 0;
  list-style: none;
}

.registrationCopy li {
  position: relative;
  padding-left: 24px;
  color: #aab5c5;
  font-size: 11px;
}

.registrationCopy li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--green);
}

.formCard {
  padding: 31px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: rgba(6, 10, 19, 0.78);
  box-shadow: 0 30px 85px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(20px);
}

.formTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 24px;
}

.formTop span {
  color: #6fdfff;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
}

.formTop h3 {
  margin: 6px 0 0;
  font-size: 25px;
}

.formTop small {
  padding: 7px 10px;
  border-radius: 999px;
  color: #9ca8b8;
  background: rgba(255, 255, 255, 0.05);
  font-size: 8px;
}

.formCard :global(form) {
  display: grid;
  gap: 14px;
}

.formCard :global(input),
.formCard :global(select),
.formCard :global(textarea) {
  width: 100%;
  min-height: 51px;
  padding: 13px 15px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 13px;
  outline: none;
  color: white;
  background: rgba(255, 255, 255, 0.035);
  font: inherit;
  font-size: 12px;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.formCard :global(textarea) {
  min-height: 120px;
  resize: vertical;
}

.formCard :global(input:focus),
.formCard :global(select:focus),
.formCard :global(textarea:focus) {
  border-color: rgba(85, 214, 255, 0.45);
  box-shadow: 0 0 0 4px rgba(85, 214, 255, 0.07);
}

.formCard :global(button[type="submit"]) {
  min-height: 56px;
  border: 1px solid rgba(112, 219, 255, 0.5);
  border-radius: 14px;
  color: #06111b;
  background: linear-gradient(110deg, #42caff, #7287ff 53%, #ad5eff);
  box-shadow: 0 18px 50px rgba(69, 170, 255, 0.23);
  font: inherit;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.faqList {
  display: grid;
  gap: 11px;
  margin-top: 42px;
}

.faqList details {
  border: 1px solid var(--line);
  border-radius: 17px;
  background: rgba(10, 16, 28, 0.72);
}

.faqList summary {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 23px;
  color: #e4e9f0;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  list-style: none;
}

.faqList summary::-webkit-details-marker {
  display: none;
}

.faqList summary span {
  color: #6edfff;
  font-size: 21px;
  transition: transform 180ms ease;
}

.faqList details[open] summary span {
  transform: rotate(45deg);
}

.faqList p {
  margin: 0;
  padding: 0 23px 23px;
  color: #7c899c;
  font-size: 11px;
  line-height: 1.7;
}

.finalCta {
  position: relative;
  z-index: 2;
  display: flex;
  width: min(1280px, calc(100% - 48px));
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  margin: 120px auto 0;
  padding: 48px;
  border: 1px solid rgba(98, 210, 255, 0.2);
  border-radius: 28px;
  background:
    radial-gradient(circle at 90% 10%, rgba(148, 75, 255, 0.17), transparent 35%),
    radial-gradient(circle at 5% 90%, rgba(62, 187, 255, 0.15), transparent 35%),
    rgba(8, 13, 24, 0.9);
}

.finalCta > div > span {
  color: #6fdfff;
  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
}

.finalCta h2 {
  font-size: clamp(40px, 5vw, 65px);
}

.finalCta > a {
  display: inline-flex;
  min-height: 57px;
  flex-shrink: 0;
  align-items: center;
  gap: 14px;
  padding: 14px 22px;
  border-radius: 15px;
  color: #06111b;
  background: linear-gradient(110deg, #42caff, #7287ff 53%, #ad5eff);
  box-shadow: 0 18px 50px rgba(69, 170, 255, 0.23);
  font-size: 12px;
  font-weight: 900;
  text-decoration: none;
}

.footer {
  position: relative;
  z-index: 2;
  display: grid;
  width: min(1280px, calc(100% - 48px));
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 25px;
  margin: 90px auto 0;
  padding: 30px 0 42px;
  border-top: 1px solid var(--line);
}

.footer p {
  color: #5e6b7f;
  font-size: 9px;
}

.footer div {
  display: flex;
  gap: 16px;
}

.footer a {
  color: #758297;
  font-size: 9px;
  text-decoration: none;
}

@keyframes dashboardFloat {
  0%, 100% {
    transform: rotateY(-8deg) rotateX(3deg) translateY(0);
  }
  50% {
    transform: rotateY(-6deg) rotateX(2deg) translateY(-12px);
  }
}

@keyframes chipFloatOne {
  0%, 100% {
    transform: translateY(0) rotate(-2deg);
  }
  50% {
    transform: translateY(-14px) rotate(1deg);
  }
}

@keyframes chipFloatTwo {
  0%, 100% {
    transform: translateY(0) rotate(2deg);
  }
  50% {
    transform: translateY(12px) rotate(-1deg);
  }
}

@keyframes leadEnter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tickerEnter {
  from {
    opacity: 0;
    transform: translateX(8px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes marquee {
  to {
    transform: translateX(-50%);
  }
}

@keyframes buttonShine {
  0% {
    left: -60%;
  }
  55%, 100% {
    left: 130%;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.65;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.12);
  }
}

@keyframes glowPulse {
  0%, 100% {
    opacity: 0.75;
    transform: scale(0.96);
  }
  50% {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes orbFloat {
  0%, 100% {
    transform: translate(0, 0);
  }
  50% {
    transform: translate(35px, -25px);
  }
}

@keyframes centralFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes rotate {
  to {
    transform: rotate(360deg);
  }
}

@keyframes arrowMove {
  0%, 100% {
    transform: translateX(-3px);
    opacity: 0.6;
  }
  50% {
    transform: translateX(4px);
    opacity: 1;
  }
}

@keyframes lineGlow {
  0%, 100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .page *,
  .page *::before,
  .page *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

@media (max-width: 1120px) {
  .header {
    grid-template-columns: 1fr auto;
  }

  .header nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .heroContent {
    max-width: 900px;
  }

  .productStage {
    min-height: 630px;
  }

  .dashboardWindow {
    right: 0;
    left: 5%;
    width: 95%;
  }

  .benefitGrid,
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .roiSection,
  .registration {
    grid-template-columns: 1fr;
  }

  .registrationCopy {
    position: static;
  }

  .processTrack {
    grid-template-columns: repeat(2, 1fr);
  }

  .processTrack > i {
    display: none;
  }
}

@media (max-width: 760px) {
  .header,
  .hero,
  .stats,
  .platformSection,
  .benefitSection,
  .roiSection,
  .processSection,
  .registration,
  .faqSection,
  .finalCta,
  .footer {
    width: min(100% - 22px, 1280px);
  }

  .headerActions > a:first-child {
    display: none;
  }

  .headerActions > a:last-child {
    padding: 10px 12px;
    font-size: 10px;
  }

  .hero {
    min-height: auto;
    margin-top: 25px;
  }

  .heroContent {
    padding: 35px 0 0;
  }

  .hero h1 {
    font-size: clamp(54px, 16vw, 76px);
  }

  .heroContent > p {
    font-size: 14px;
  }

  .heroButtons,
  .heroButtons a {
    width: 100%;
  }

  .productStage {
    min-height: 440px;
  }

  .dashboardWindow {
    top: 55px;
    left: 0;
    width: 130%;
    transform: scale(0.75);
    transform-origin: top left;
    animation: mobileDashboardFloat 6s ease-in-out infinite;
  }

  .floatingChipOne {
    top: 15px;
  }

  .floatingChipTwo {
    display: none;
  }

  .stats,
  .benefitGrid,
  .processTrack {
    grid-template-columns: 1fr;
  }

  .platformVisual {
    grid-template-columns: 1fr;
    padding: 25px;
  }

  .centralFlow {
    min-height: 210px;
    width: 210px;
    margin: 0 auto;
  }

  .roiSection,
  .registration {
    padding: 29px 21px;
  }

  .roiCalculation {
    grid-template-columns: 1fr;
  }

  .roiArrow {
    transform: rotate(90deg);
    text-align: center;
  }

  .formCard {
    padding: 22px 17px;
  }

  .finalCta {
    align-items: flex-start;
    flex-direction: column;
    padding: 30px 22px;
  }

  .finalCta > a {
    width: 100%;
    justify-content: center;
  }

  .footer {
    grid-template-columns: 1fr;
  }
}

@keyframes mobileDashboardFloat {
  0%, 100% {
    transform: scale(0.75) translateY(0);
  }
  50% {
    transform: scale(0.75) translateY(-10px);
  }
}
