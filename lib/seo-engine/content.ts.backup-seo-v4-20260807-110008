import type { CityProfile } from "@/data/seo/city-profiles";
import type { ServiceProfile } from "@/data/seo/service-profiles";

function stableIndex(seed: string, length: number) {
  let hash = 0;

  for (let index = 0; index < seed.length; index += 1) {
    hash = (hash * 31 + seed.charCodeAt(index)) >>> 0;
  }

  return length ? hash % length : 0;
}

function choose(seed: string, values: string[]) {
  return values[stableIndex(seed, values.length)];
}

function formatPrice(value: number) {
  return value.toLocaleString("de-CH");
}

export function buildSeoContent(
  service: ServiceProfile,
  city: CityProfile
) {
  const seed = `${service.slug}-${city.slug}`;

  const opening = choose(seed, [
    `Wer in ${city.name} einen passenden Anbieter für ${service.name} sucht, sollte den Auftrag möglichst genau beschreiben und mehrere Rückmeldungen vergleichen.`,
    `${service.name} in ${city.name} lässt sich einfacher organisieren, wenn Umfang, Termin und gewünschte Zusatzleistungen von Anfang an klar sind.`,
    `Für ${service.name} in ${city.name} lohnt sich ein Vergleich regionaler Firmen, damit Leistung, Termin und Preis zum Auftrag passen.`,
  ]);

  const comparison = choose(`${seed}-comparison`, [
    "Achte darauf, ob Anfahrt, Material, Entsorgung und mögliche Zusatzarbeiten bereits im Preis enthalten sind.",
    "Vergleiche neben dem Preis auch Erreichbarkeit, Leistungsumfang, Terminbestätigung und den Umgang mit Zusatzaufwand.",
    "Eine nachvollziehbare Offerte sollte die wichtigsten Arbeiten, Ausschlüsse und Kostenpositionen verständlich ausweisen.",
  ]);

  const localDemand = choose(`${seed}-local`, [
    `In ${city.name} entstehen Aufträge für ${service.name} sowohl bei privaten Haushalten als auch bei Verwaltungen, Gewerbebetrieben und Eigentümern. Regionale Anbieter kennen die üblichen Anfahrtswege und können Termine häufig flexibel koordinieren.`,
    `${city.name} bietet ein vielfältiges Umfeld aus Wohnobjekten, Unternehmen und Liegenschaften. Entsprechend unterschiedlich können die Anforderungen an ${service.name} ausfallen.`,
    `Bei ${service.name} in ${city.name} spielen neben der eigentlichen Leistung oft auch Zugänglichkeit, Objektgrösse, Terminlage und gewünschte Zusatzarbeiten eine Rolle.`,
  ]);

  const serviceOverview = [
    `${service.name} kann je nach Auftrag Beratung, Vorbereitung, fachgerechte Ausführung und abschliessende Kontrolle umfassen.`,
    `Der genaue Leistungsumfang sollte vor Auftragserteilung schriftlich festgehalten werden. So lassen sich Missverständnisse und unerwartete Zusatzkosten vermeiden.`,
    `Bei umfangreicheren Arbeiten kann eine Besichtigung oder eine ergänzende Rückfrage sinnvoll sein, bevor eine verbindliche Offerte erstellt wird.`,
  ];

  const preparationSteps = [
    "Auftrag, Objekt und gewünschtes Ergebnis möglichst genau beschreiben",
    "Gewünschten Termin und mögliche Alternativtermine angeben",
    "Fotos, Masse oder weitere hilfreiche Informationen bereitstellen",
    "Zugänglichkeit, Parkplatzsituation und Besonderheiten erwähnen",
    "Gewünschte Zusatzleistungen ausdrücklich aufführen",
  ];

  const qualityChecklist = [
    "Sind alle gewünschten Leistungen in der Offerte enthalten?",
    "Sind Material, Anfahrt und Entsorgung klar ausgewiesen?",
    "Ist der Ausführungstermin verbindlich bestätigt?",
    "Sind mögliche Zusatzkosten nachvollziehbar beschrieben?",
    "Gibt es eine klare Kontaktperson für Rückfragen?",
  ];

  const costFactors = [
    "Umfang und Schwierigkeit des Auftrags",
    "Grösse und Zustand des Objekts",
    "Material- und Geräteeinsatz",
    "Zugänglichkeit und Anfahrtsweg",
    "Termin, Dringlichkeit und Zusatzleistungen",
  ];

  const customerGroups = [
    "Privathaushalte und Mietparteien",
    "Eigentümerinnen und Eigentümer",
    "Liegenschaftsverwaltungen",
    "Gewerbe- und Bürobetriebe",
    "Gemeinden, Vereine und weitere Organisationen",
  ];

  const priceIntro =
    service.priceFrom && service.priceTo
      ? `Als grobe Orientierung können Aufträge je nach Umfang zwischen CHF ${formatPrice(
          service.priceFrom
        )} und CHF ${formatPrice(
          service.priceTo
        )} liegen. Der konkrete Preis hängt von Aufwand, Objekt, Termin, Material und Zusatzleistungen ab.`
      : `Der Preis hängt von Umfang, Termin, Material, Zugänglichkeit und gewünschten Zusatzleistungen ab. Eine vollständige Anfrage erleichtert einen aussagekräftigen Vergleich.`;

  return {
    heroTitle: `${service.name} in ${city.name}`,
    heroDescription: `${service.description} Erstelle eine kostenlose Anfrage und vergleiche regionale Anbieter in ${city.name} und Umgebung.`,
    localIntro: `${city.introVariant} ${opening}`,
    comparisonText: comparison,
    localDemand,
    serviceOverview,
    preparationSteps,
    qualityChecklist,
    costFactors,
    customerGroups,
    priceIntro,
    planningText: `Eine gute Vorbereitung spart Zeit bei der Angebotserstellung. Je genauer die Angaben zu Objekt, Umfang und Termin sind, desto besser können Anbieter den Aufwand einschätzen.`,
    privateBusinessText: `${service.name} wird in ${city.name} sowohl für private als auch für gewerbliche Aufträge gesucht. Privatkunden legen häufig Wert auf flexible Termine und eine verständliche Offerte. Unternehmen und Verwaltungen benötigen zusätzlich oft klare Abläufe, feste Ansprechpartner und eine nachvollziehbare Dokumentation.`,
    conclusionText: `Mit einer vollständigen Anfrage und einem sorgfältigen Vergleich findest du für ${service.name} in ${city.name} einen Anbieter, dessen Leistung, Verfügbarkeit und Preis zu deinem Auftrag passen.`,
    ctaTitle: `${service.name} in ${city.name} anfragen`,
    ctaText:
      "Beschreibe deinen Auftrag kostenlos und unverbindlich. Passende Anbieter können sich direkt bei dir melden.",
  };
}

