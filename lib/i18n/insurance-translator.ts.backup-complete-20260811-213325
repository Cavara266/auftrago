const dictionaries: Partial<Record<Locale, Dictionary>> = {
  fr,
  en,
  it,
  sq,
  tr,
  pt,
  es,
};

function normalizeInsuranceText(value: string): string {
  return value
    .replace(/\u00a0/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function createNormalizedDictionary(dictionary: Dictionary): Dictionary {
  return Object.fromEntries(
    Object.entries(dictionary).map(([key, value]) => [
      normalizeInsuranceText(key),
      value,
    ])
  );
}

const normalizedDictionaries: Partial<Record<Locale, Dictionary>> = {
  fr: createNormalizedDictionary(fr),
  en: createNormalizedDictionary(en),
  it: createNormalizedDictionary(it),
  sq: createNormalizedDictionary(sq),
  tr: createNormalizedDictionary(tr),
  pt: createNormalizedDictionary(pt),
  es: createNormalizedDictionary(es),
};

export function translateInsuranceText(
  locale: Locale,
  value: string
): string {
  if (locale === "de") {
    return value;
  }

  const dictionary = dictionaries[locale];
  const generatedDictionary =
    insuranceGeneratedDictionaries[
      locale as keyof typeof insuranceGeneratedDictionaries
    ];

  const normalizedDictionary = normalizedDictionaries[locale];

  if (!dictionary || !normalizedDictionary) {
    return value;
  }

  // 1. Exakter Treffer im bestehenden Dictionary
  const exact = dictionary[value];

  if (exact) {
    return exact;
  }

  // 2. Vollständiges automatisch generiertes Seiten-Dictionary
  const generatedExact = generatedDictionary?.[value];

  if (generatedExact) {
    return generatedExact;
  }

  // 2. Gleicher Text trotz Zeilenumbrüchen / mehrfachen Leerzeichen
  const normalizedValue = normalizeInsuranceText(value);
  const normalized = normalizedDictionary[normalizedValue];

  if (normalized) {
    return normalized;
  }

  // 3. Generiertes Dictionary auch normalisiert durchsuchen
  if (generatedDictionary) {
    for (const [source, translated] of Object.entries(
      generatedDictionary
    )) {
      if (
        normalizeInsuranceText(source) === normalizedValue
      ) {
        return translated;
      }
    }
  }

  // Nicht übersetzte Texte bleiben absichtlich unverändert,
  // damit niemals undefined oder leerer Inhalt ausgegeben wird.
  return value;
}
