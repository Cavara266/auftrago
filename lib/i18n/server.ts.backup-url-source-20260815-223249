import { headers } from "next/headers";

import {
  defaultLocale,
  normalizeLocale,
  type Locale,
} from "./config";

/**
 * WICHTIG:
 *
 * Die URL / Middleware ist die einzige Quelle für die Server-Sprache.
 *
 * /anbieter       => de
 * /fr/anbieter    => fr
 * /it/anbieter    => it
 * /en/anbieter    => en
 * /sq/anbieter    => sq
 * /tr/anbieter    => tr
 * /pt/anbieter    => pt
 * /es/anbieter    => es
 *
 * Cookies dürfen die Server-Ausgabe NICHT verändern.
 * Sonst entstehen React-Hydration-Fehler:
 * Server = Französisch
 * Client = Deutsch
 */
export async function getServerLocale(): Promise<Locale> {
  try {
    const headerStore = await headers();

    const headerLocale =
      headerStore.get("x-auftrago-locale");

    if (headerLocale) {
      return normalizeLocale(headerLocale);
    }

    return defaultLocale;
  } catch {
    return defaultLocale;
  }
}
