const dictionaries: Partial<Record<Locale, Dictionary>> = {
  fr,
  en,
};

function normalizeInsuranceText(value: string): string {
  return value
    .replace(/\u00a0/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function createNormalizedDictionary(dictionary: Dictionary): Dictionary {
  return Object.fromEntries(
    Object.entries(dictionary).map(([key, value]) => [
      normalizeInsuranceText(key),
      value,
    ])
  );
}

const normalizedDictionaries: Partial<Record<Locale, Dictionary>> = {
  fr: createNormalizedDictionary(fr),
  en: createNormalizedDictionary(en),
};

export function translateInsuranceText(
  locale: Locale,
  value: string
): string {
  if (locale === "de") {
    return value;
  }

  const dictionary = dictionaries[locale];
  const normalizedDictionary = normalizedDictionaries[locale];

  if (!dictionary || !normalizedDictionary) {
    return value;
  }

  // 1. Exakter Treffer
  const exact = dictionary[value];

  if (exact) {
    return exact;
  }

  // 2. Gleicher Text trotz Zeilenumbrüchen / mehrfachen Leerzeichen
  const normalizedValue = normalizeInsuranceText(value);
  const normalized = normalizedDictionary[normalizedValue];

  if (normalized) {
    return normalized;
  }

  // Nicht übersetzte Texte bleiben absichtlich unverändert,
  // damit niemals undefined oder leerer Inhalt ausgegeben wird.
  return value;
}
