import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { getCurrentUser } from "@/lib/auth";
import { sendMail } from "@/lib/mail/mail";

export async function POST(
  request: Request,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const user = await getCurrentUser();

    if (!user) {
      return NextResponse.json(
        { error: "Nicht angemeldet." },
        { status: 401 }
      );
    }

    const { id } = await params;
    const body = await request.json();

    const job = await prisma.businessJob.findFirst({
      where: {
        id,
        providerId: user.id,
      },
    });

    if (!job) {
      return NextResponse.json(
        { error: "Einsatz nicht gefunden." },
        { status: 404 }
      );
    }

    const message = String(body.message || "").trim();

    if (!message) {
      return NextResponse.json(
        { error: "Nachricht fehlt." },
        { status: 400 }
      );
    }

    const sendEmail = body.sendEmail === true;

    if (sendEmail) {
      if (!job.customerEmail) {
        return NextResponse.json(
          { error: "Beim Kunden ist keine E-Mail hinterlegt." },
          { status: 400 }
        );
      }

      await sendMail({
        to: job.customerEmail,
        subject: `Information zu Ihrem Termin – ${job.title}`,
        html: `
          <div style="font-family:Arial,Helvetica,sans-serif;max-width:620px;margin:auto;color:#101828;">
            <div style="background:#071426;padding:26px 30px;border-radius:14px 14px 0 0;">
              <div style="font-size:12px;font-weight:800;color:#38bdf8;letter-spacing:.08em;">
                AUFTRAGO BUSINESS
              </div>
              <div style="font-size:24px;font-weight:900;color:#ffffff;margin-top:5px;">
                Information zu Ihrem Termin
              </div>
            </div>

            <div style="padding:28px 30px;border:1px solid #e2e8f0;border-top:0;">
              <p>Guten Tag ${job.customerName || ""}</p>

              <p style="line-height:1.7;">
                ${message.replace(/\n/g, "<br/>")}
              </p>

              <p style="margin-top:26px;">
                Freundliche Grüsse<br/>
                ${user.name || user.email || "Ihr Dienstleister"}
              </p>
            </div>
          </div>
        `,
        text:
          `Guten Tag ${job.customerName || ""}\n\n` +
          `${message}\n\n` +
          `Freundliche Grüsse\n` +
          `${user.name || user.email || "Ihr Dienstleister"}`,
      });
    }

    return NextResponse.json({
      ok: true,
      sentEmail: sendEmail,
      whatsappText: message,
    });
  } catch (error) {
    console.error("JOB CUSTOMER NOTIFY ERROR", error);

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Nachricht konnte nicht vorbereitet werden.",
      },
      { status: 500 }
    );
  }
}
