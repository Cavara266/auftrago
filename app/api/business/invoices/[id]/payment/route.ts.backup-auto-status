import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { getCurrentUser } from "@/lib/auth";

export async function POST(
  request: Request,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const user = await getCurrentUser();

    if (!user) {
      return NextResponse.json({ error: "Nicht angemeldet" }, { status: 401 });
    }

    const { id } = await params;
    const body = await request.json();

    const amount = Number(body.amount);
    const note = String(body.note || "").trim();

    if (!Number.isFinite(amount) || amount <= 0) {
      return NextResponse.json(
        { error: "Ungültiger Zahlungsbetrag" },
        { status: 400 }
      );
    }

    const amountCents = Math.round(amount * 100);

    const invoice = await prisma.businessInvoice.findFirst({
      where: {
        id,
        providerId: user.id,
      },
    });

    if (!invoice) {
      return NextResponse.json(
        { error: "Rechnung nicht gefunden" },
        { status: 404 }
      );
    }

    const remainingCents = Math.max(
      0,
      invoice.totalCents - invoice.paidAmountCents
    );

    if (amountCents > remainingCents) {
      return NextResponse.json(
        { error: "Zahlung ist höher als der offene Betrag" },
        { status: 400 }
      );
    }

    const newPaidAmount = invoice.paidAmountCents + amountCents;
    const fullyPaid = newPaidAmount >= invoice.totalCents;

    const result = await prisma.$transaction(async (tx) => {
      const payment = await tx.businessInvoicePayment.create({
        data: {
          invoiceId: invoice.id,
          amountCents,
          note: note || null,
        },
      });

      const updated = await tx.businessInvoice.update({
        where: { id: invoice.id },
        data: {
          paidAmountCents: newPaidAmount,
          status: fullyPaid ? "PAID" : "OPEN",
          paidAt: fullyPaid ? new Date() : null,
        },
        include: {
          payments: {
            orderBy: {
              paymentDate: "desc",
            },
          },
        },
      });

      return { payment, invoice: updated };
    });

    return NextResponse.json({
      ok: true,
      ...result,
    });
  } catch (error) {
    console.error("PAYMENT CREATE ERROR", error);

    return NextResponse.json(
      { error: "Zahlung konnte nicht gespeichert werden" },
      { status: 500 }
    );
  }
}

export async function DELETE(
  request: Request,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const user = await getCurrentUser();

    if (!user) {
      return NextResponse.json({ error: "Nicht angemeldet" }, { status: 401 });
    }

    const { id } = await params;
    const body = await request.json();

    const paymentId = String(body.paymentId || "").trim();

    if (!paymentId) {
      return NextResponse.json(
        { error: "Zahlungs-ID fehlt" },
        { status: 400 }
      );
    }

    const invoice = await prisma.businessInvoice.findFirst({
      where: {
        id,
        providerId: user.id,
      },
    });

    if (!invoice) {
      return NextResponse.json(
        { error: "Rechnung nicht gefunden" },
        { status: 404 }
      );
    }

    const payment = await prisma.businessInvoicePayment.findFirst({
      where: {
        id: paymentId,
        invoiceId: invoice.id,
      },
    });

    if (!payment) {
      return NextResponse.json(
        { error: "Zahlung nicht gefunden" },
        { status: 404 }
      );
    }

    const newPaidAmount = Math.max(
      0,
      invoice.paidAmountCents - payment.amountCents
    );

    const newStatus =
      newPaidAmount >= invoice.totalCents
        ? "PAID"
        : newPaidAmount > 0
          ? "OPEN"
          : "OPEN";

    const result = await prisma.$transaction(async (tx) => {
      await tx.businessInvoicePayment.delete({
        where: {
          id: payment.id,
        },
      });

      const updated = await tx.businessInvoice.update({
        where: {
          id: invoice.id,
        },
        data: {
          paidAmountCents: newPaidAmount,
          status: newStatus,
          paidAt: newStatus === "PAID" ? invoice.paidAt : null,
        },
        include: {
          payments: {
            orderBy: {
              paymentDate: "desc",
            },
          },
        },
      });

      return updated;
    });

    return NextResponse.json({
      ok: true,
      invoice: result,
    });
  } catch (error) {
    console.error("PAYMENT DELETE ERROR", error);

    return NextResponse.json(
      { error: "Zahlung konnte nicht gelöscht werden" },
      { status: 500 }
    );
  }
}
